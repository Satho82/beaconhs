1542400003,\n    \"blob\": \"ad7f54f883ee62c4522709bfa03c8b58205ef22a\"\n  },\n  {\n    \"tag\": \"0061_risk_assessment_revisions_archive_signoffs\",\n    \"idx\": 60,\n    \"when\": 1791542400004,\n    \"blob\": \"ce9a4ae38b221b21c81849811bfe9fa8b1e8e4e6\"\n  },\n  {\n    \"tag\": \"0062_approvals_batch01\",\n    \"idx\": 61,\n    \"when\": 1791824400000,\n    \"blob\": \"77cd4a402e3e8a32acf25b1dedb36f97cb130dff\"\n  },\n  {\n    \"tag\": \"0063_approvals_production\",\n    \"idx\": 62,\n    \"when\": 1791831600000,\n    \"blob\": \"000d76e52c965c6487707f20cd4a7f1c13436e3d\"\n  }\n]\n","packages/db/src/dev-migration-gate.ts":"import { createHash } from 'node:crypto'\nimport { readFileSync, readdirSync } from 'node:fs'\nimport { resolve } from 'node:path'\nimport { fileURLToPath } from 'node:url'\nimport { execFileSync } from 'node:child_process'\nimport postgres from 'postgres'\nimport { sql } from 'drizzle-orm'\nimport type { MigrationDatabase } from './migration-connection'\nimport { readMigrationFiles, type MigrationFile } from './migration-state'\nimport identities from './dev-migration-identities.json'\n\nexport type Query = (statement: string) => Promise<Record<string, unknown>[]>\nexport type LedgerRow = { id: number; hash: string; created_at: string | number }\nexport type ReleaseEvidence = {\n  version: 1\n  sourceSha: string\n  sourceTree: string\n  imageDigest: string\n  database: string\n  databaseOid: number\n  postgresVersion: string\n  migrations: MigrationFile[]\n  schemas: Record<string, string>\n  backup: {\n    file: string\n    sha256: string\n    createdAt: string\n    restoredAt: string\n    restoreRun: string\n    ledgerHash: string\n    dataHash: string\n    schemaHash: string\n    restoredLedgerHash: string\n    restoredDataHash: string\n    restoredSchemaHash: string\n    rollbackImageDigest: string\n  }\n}\nconst hashPattern = /^[a-f0-9]{64}$/\nexport function digest(value: string | Buffer): string {\n  return createHash('sha256').update(value).digest('hex')\n}\nfunction stable(value: unknown): string {\n  if (Array.isArray(value)) return '[' + value.map(stable).join(',') + ']'\n  if (value && typeof value === 'object')\n    return '{' + Object.entries(value).sort(([a], [b]) => a.localeCompare(b))\n      .map(([k, v]) => JSON.stringify(k) + ':' + stable(v)).join(',') + '}'\n  return JSON.stringify(value) ?? 'null'\n}\nexport function strictPrefix(files: MigrationFile[], rows: LedgerRow[]): number {\n  if (!files.length || !rows.length || rows.length > files.length)\n    throw new Error('DEV ledger is empty or ahead of the approved source')\n  let previous = 0\n  for (const [i, row] of rows.entries()) {\n    const expected = files[i]\n    if (!Number.isSafeInteger(row.id) || row.id <= previous || !expected ||\n        row.hash !== expected.hash || Number(row.created_at) !== expected.createdAt)\n      throw new Error('DEV migration ledger is not an exact ordered source prefix')\n    previous = row.id\n  }\n  return rows.length\n}\nexport function sourceMigrations(folder: string): MigrationFile[] {\n  const journal = JSON.parse(readFileSync(resolve(folder, 'meta/_journal.json'), 'utf8'))\n  const files = readMigrationFiles(folder)\n  if (files.length < 61) throw new Error('DEV target predates the governed migration baseline')\n  const disk = readdirSync(folder).filter((name) => /^\\d{4}_.+\\.sql$/.test(name)).sort()\n  if (stable(disk) !== stable(files.map((f) => f.tag + '.sql').sort()))\n    throw new Error('DEV source contains unregistered or missing SQL')\n  for (const [i, file] of files.entries()) {\n    if (journal.entries[i].idx !== i || journal.entries[i].version !== '7' || journal.entries[i].breakpoints !== true) throw new Error('DEV journal order rejected')\n    const locked = identities[i]\n    if (locked) {\n      const bytes = readFileSync(resolve(folder, file.tag + '.sql'))\n      const blob = createHash('sha1').update('blob ' + bytes.length + '\\0').update(bytes).digest('hex')\n      if (file.tag !== locked.tag || file.createdAt !== locked.when || blob !== locked.blob)\n        throw new Error('DEV immutable historical migration identity changed')\n    }\n  }\n  return files\n}\nexport function validateEvidence(\n  evidence: ReleaseEvidence,\n  files: MigrationFile[],\n  expected: { sourceSha: string; sourceTree: string; imageDigest: string },\n  now = Date.now(),\n): void {\n  if (evidence.version !== 1 || !/^[a-f0-9]{40}$/.test(expected.sourceSha) ||\n      !/^[a-f0-9]{40}$/.test(expected.sourceTree) ||\n      !/^sha256:[a-f0-9]{64}$/.test(expected.imageDigest) ||\n      evidence.sourceSha !== expected.sourceSha || evidence.sourceTree !== expected.sourceTree ||\n      evidence.imageDigest !== expected.imageDigest || stable(evidence.migrations) !== stable(files))\n    throw new Error('DEV release evidence source/image identity rejected')\n  const b = evidence.backup\n  const created = Date.parse(b.createdAt)\n  const restored = Date.parse(b.restoredAt)\n  if (!Number.isFinite(created) || !Number.isFinite(restored) || created > restored ||\n      restored > now || now - created > 60 * 60 * 1000 ||\n      !/^[a-zA-Z0-9_-]+\\.dump\\.age$/.test(b.file) ||\n      !hashPattern.test(b.sha256) || !hashPattern.test(b.ledgerHash) ||\n      !hashPattern.test(b.dataHash) || !hashPattern.test(b.schemaHash) ||\n      b.restoredLedgerHash !== b.ledgerHash || b.restoredDataHash !== b.dataHash ||\n      b.restoredSchemaHash !== b.schemaHash ||\n      !/^https:\\/\\/github\\.com\\/Satho82\\/beaconhs\\/actions\\/runs\\/[0-9]+$/.test(b.restoreRun) ||\n      !/^sha256:[a-f0-9]{64}$/.test(b.rollbackImageDigest))\n    throw new Error('DEV verified encrypted backup/restore readiness rejected')\n  if (!Object.values(evidence.schemas).every((h) => hashPattern.test(h)) ||\n      !hashPattern.test(evidence.schemas[String(files.length)] ?? ''))\n    throw new Error('DEV trusted target schema evidence missing')\n}\nconst userSchema = \"n.nspname NOT LIKE 'pg_%' AND n.nspname <> 'information_schema'\"\n/** Catalogue only. No pg_dump, DDL, seed, grants, or application changes. */\nexport async function schemaFingerprint(query: Query): Promise<string> {\n  const sections = [\n    \"SELECT pg_get_userbyid(datdba) owner,datacl::text acl,datconnlimit,datallowconn FROM pg_database WHERE datname=current_database()\",\n    'SELECT n.nspname,pg_get_userbyid(n.nspowner) owner,n.nspacl::text acl FROM pg_namespace n WHERE ' + userSchema,\n    'SELECT n.nspname,c.relname,c.relkind,c.relrowsecurity,c.relforcerowsecurity,pg_get_userbyid(c.relowner) owner,c.relacl::text acl,c.reloptions,c.relispartition,pg_get_expr(c.relpartbound,c.oid) partition_bound FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE ' + userSchema,\n    'SELECT n.nspname,c.relname,a.attname,a.attnum,format_type(a.atttypid,a.atttypmod) type,a.attnotnull,a.attidentity,a.attgenerated,a.attstorage,a.attcompression,(SELECT collname FROM pg_collation WHERE oid=a.attcollation) collation,a.attacl::text acl,pg_get_expr(d.adbin,d.adrelid) expression FROM pg_attribute a JOIN pg_class c ON c.oid=a.attrelid JOIN pg_namespace n ON n.oid=c.relnamespace LEFT JOIN pg_attrdef d ON d.adrelid=c.oid AND d.adnum=a.attnum WHERE a.attnum>0 AND NOT a.attisdropped AND ' + userSchema,\n    'SELECT n.nspname,c.relname,k.conname,k.contype,k.convalidated,pg_get_constraintdef(k.oid,true) definition FROM pg_constraint k JOIN pg_class c ON c.oid=k.conrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE ' + userSchema,\n    'SELECT n.nspname,c.relname,i.indisvalid,i.indisready,pg_get_indexdef(i.indexrelid) definition FROM pg_index i JOIN pg_class c ON c.oid=i.indrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE ' + userSchema,\n    'SELECT n.nspname,c.relname,t.tgname,t.tgenabled,pg_get_triggerdef(t.oid,true) definition FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE NOT t.tgisinternal AND ' + userSchema,\n    \"SELECT n.nspname,p.proname,pg_get_function_identity_arguments(p.oid) args,pg_get_functiondef(p.oid) definition,pg_get_userbyid(p.proowner) owner,p.proacl::text acl FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE p.prokind IN ('f','p') AND \" + userSchema,\n    \"SELECT schemaname,tablename,policyname,permissive,roles,cmd,qual,with_check FROM pg_policies WHERE schemaname NOT LIKE 'pg_%'\",\n    'SELECT n.nspname,c.relname,pg_get_viewdef(c.oid,true) definition FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE c.relkind IN (\\'v\\',\\'m\\') AND ' + userSchema,\n    'SELECT n.nspname,t.typname,t.typtype,pg_get_userbyid(t.typowner) owner,t.typacl::text acl,e.enumlabel,e.enumsortorder FROM pg_type t JOIN pg_namespace n ON n.oid=t.typnamespace LEFT JOIN pg_enum e ON e.enumtypid=t.oid WHERE ' + userSchema,\n    \"SELECT rolname,rolsuper,rolinherit,rolcreaterole,rolcreatedb,rolcanlogin,rolreplication,rolbypassrls,rolconfig FROM pg_roles WHERE rolname LIKE 'beaconhs_%'\",\n    \"SELECT p.rolname parent,m.rolname member,a.admin_option,a.inherit_option,a.set_option FROM pg_auth_members a JOIN pg_roles p ON p.oid=a.roleid JOIN pg_roles m ON m.oid=a.member WHERE p.rolname LIKE 'beaconhs_%' OR m.rolname LIKE 'beaconhs_%'\",\n    \"SELECT pg_get_userbyid(d.defaclrole) owner,coalesce(n.nspname,'') schema,d.defaclobjtype,d.defaclacl::text acl FROM pg_default_acl d LEFT JOIN pg_namespace n ON n.oid=d.defaclnamespace WHERE pg_get_userbyid(d.defaclrole) LIKE 'beaconhs_%'\",\n    \"SELECT e.evtname,e.evtevent,e.evtenabled,e.evttags,pg_get_userbyid(e.evtowner) owner,e.evtfoid::regprocedure::text function FROM pg_event_trigger e\",\n    \"SELECT n.nspname,c.relname,r.rulename,pg_get_ruledef(r.oid,true) definition FROM pg_rewrite r JOIN pg_class c ON c.oid=r.ev_class JOIN pg_namespace n ON n.oid=c.relnamespace WHERE \" + userSchema,\n    \"SELECT n.nspname,t.typname,k.conname,pg_get_constraintdef(k.oid,true) definition FROM pg_constraint k JOIN pg_type t ON t.oid=k.contypid JOIN pg_namespace n ON n.oid=t.typnamespace WHERE \" + userSchema,\n    'SELECT extname,extversion,pg_get_userbyid(extowner) owner FROM pg_extension',\n    \"SELECT schemaname,sequencename,sequenceowner,data_type,start_value,min_value,max_value,increment_by,cycle,cache_size FROM pg_sequences WHERE schemaname NOT LIKE 'pg_%'\",\n  ]\n  const results = []\n  for (const statement of sections) results.push((await query(statement)).map(stable).sort())\n  return digest(stable(results))\n}\nexport async function dataFingerprint(query: Query): Promise<string> {\n  const tables = await query(\"SELECT n.nspname,c.relname FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE c.relkind IN ('r','m') AND n.nspname NOT LIKE 'pg_%' AND n.nspname NOT IN ('information_schema','drizzle') ORDER BY n.nspname,c.relname\")\n  const result = []\n  const quote = (s: unknown) => '\"' + String(s).replaceAll('\"', '\"\"') + '\"'\n  for (const table of tables) {\n    const relation = quote(table.nspname) + '.' + quote(table.relname)\n    const rows = await query(\"SELECT count(*)::text count,md5(coalesce(string_agg(h,'' ORDER BY h),'')) hash FROM (SELECT md5(to_jsonb(t)::text) h FROM \" + relation + ' t) q')\n    result.push([table.nspname, table.relname, rows])\n  }\n  result.push(['sequences', await query(\"SELECT schemaname,sequencename,last_value FROM pg_sequences WHERE schemaname NOT LIKE 'pg_%' ORDER BY schemaname,sequencename\")])\n  return digest(stable(result))\n}\nexport async function readLedger(query: Query): Promise<LedgerRow[]> {\n  const rows = await query('SELECT id,hash,created_at::text FROM drizzle.__drizzle_migrations ORDER BY id')\n  return rows.map((r) => ({ id: Number(r.id), hash: String(r.hash), created_at: String(r.created_at) }))\n}\nexport function ledgerFingerprint(rows: LedgerRow[]): string {\n  return digest(stable(rows.map((r) => ({ ...r, created_at: String(r.created_at) }))))\n}\nexport async function verifyState(\n  query: Query, evidence: ReleaseEvidence, files: MigrationFile[], complete: boolean,\n): Promise<LedgerRow[]> {\n  const [identity] = await query('SELECT current_database() name,(SELECT oid::integer FROM pg_database WHERE datname=current_database()) oid,current_setting(\\'server_version_num\\') version')\n  if (identity?.name !== evidence.database || identity?.oid !== evidence.databaseOid ||\n      identity?.version !== evidence.postgresVersion) throw new Error('DEV database identity rejected')\n  const rows = await readLedger(query)\n  const prefix = strictPrefix(files, rows)\n  if (complete && prefix !== files.length) throw new Error('DEV target migration suffix incomplete')\n  const actual = await schemaFingerprint(query)\n  if (actual !== evidence.schemas[String(prefix)]) throw new Error('DEV schema/security drift rejected')\n  if (!complete && (ledgerFingerprint(rows) !== evidence.backup.ledgerHash ||\n      actual !== evidence.backup.schemaHash)) throw new Error('DEV backup does not cover current state')\n  return rows\n}\nexport async function loadDevMigrationGate(folder: string) {\n  const evidencePath = process.env.DEV_RELEASE_EVIDENCE_PATH\n  const expectedDigest = process.env.DEV_RELEASE_EVIDENCE_SHA256 ?? ''\n  if (!evidencePath || !hashPattern.test(expectedDigest)) throw new Error('DEV approved release evidence required')\n  const bytes = readFileSync(evidencePath)\n  if (digest(bytes) !== expectedDigest) throw new Error('DEV evidence checksum mismatch')\n  const evidence = JSON.parse(bytes.toString('utf8')) as ReleaseEvidence\n  const files = sourceMigrations(folder)\n  const git = (arg: string) => execFileSync('git', ['-c', 'safe.directory=/workspace', 'rev-parse', arg], { encoding: 'utf8' }).trim()\n  execFileSync('git', ['-c', 'safe.directory=/workspace', 'diff', '--exit-code'], { stdio: 'pipe' })\n  execFileSync('git', ['-c', 'safe.directory=/workspace', 'diff', '--cached', '--exit-code'], { stdio: 'pipe' })\n  const sourceSha = git('HEAD')\n  const sourceTree = git('HEAD^{tree}')\n  if (sourceSha !== process.env.DEPLOY_SOURCE_SHA) throw new Error('DEV checkout source mismatch')\n  validateEvidence(evidence, files, { sourceSha, sourceTree, imageDigest: process.env.IMAGE_DIGEST ?? '' })\n  if (evidence.database !== 'beaconhs') throw new Error('DEV persistent database must be beaconhs')\n  if (digest(readFileSync(resolve(evidencePath, '..', evidence.backup.file))) !== evidence.backup.sha256)\n    throw new Error('DEV encrypted backup checksum mismatch')\n  const backupUrl = process.env.DEV_BACKUP_DATABASE_URL\n  if (!backupUrl) throw new Error('DEV backup-role connection required')\n  const backupIdentity = new URL(backupUrl)\n  const migrationIdentity = new URL(process.env.MIGRATION_DATABASE_URL!)\n  if (backupIdentity.protocol !== 'postgresql:' || !backupIdentity.password ||\n      backupIdentity.hostname !== migrationIdentity.hostname ||\n      backupIdentity.port !== migrationIdentity.port || backupIdentity.pathname !== migrationIdentity.pathname ||\n      decodeURIComponent(backupIdentity.username) !== 'beaconhs_backup')\n    throw new Error('DEV backup connection target rejected')\n  return {\n    before: async (db: MigrationDatabase) => {\n      validateEvidence(evidence, files, { sourceSha, sourceTree, imageDigest: process.env.IMAGE_DIGEST ?? '' })\n      const query: Query = async (statement) => Array.from(await db.execute(sql.raw(statement))) as Record<string, unknown>[]\n      await verifyState(query, evidence, files, false)\n      const backup = postgres(backupUrl, { max: 1, prepare: false, onnotice: () => undefined })\n      try {\n        await backup.begin('isolation level repeatable read read only', async (tx) => {\n          const [role] = await tx.unsafe(\"SELECT current_user name,rolsuper,rolbypassrls,current_setting('transaction_read_only') readonly FROM pg_roles WHERE rolname=current_user\")\n          if (role?.name !== 'beaconhs_backup' || role.rolsuper || !role.rolbypassrls || role.readonly !== 'on')\n            throw new Error('DEV backup role rejected')\n          const backupQuery: Query = async (s) => Array.from(await tx.unsafe(s)) as Record<string, unknown>[]\n          if (await dataFingerprint(backupQuery) !== evidence.backup.dataHash)\n            throw new Error('DEV data changed since verified backup')\n        })\n      } finally { await backup.end() }\n    },\n    after: async (db: MigrationDatabase) => {\n      const query: Query = async (statement) => Array.from(await db.execute(sql.raw(statement))) as Record<string, unknown>[]\n      await verifyState(query, evidence, files, true)\n    },\n  }\n}\nexport const devMigrationFolder = fileURLToPath(new URL('../drizzle', import.meta.url))\n","packages/db/src/migrate-dev.ts":"/** DEV-only entrypoint. Approval evidence is mandatory before any database mutation. */\nif (process.env.FEATURE_CANDIDATE_VERIFIED !== 'true') {\n  throw new Error('DEV migration entrypoint requires verified candidate context')\n}\nawait import('./migrate')\nexport {}\n","packages/db/src/migrate.ts":"import { loadDevMigrationGate } from './dev-migration-gate'\nimport { executePendingMigrations, loadMigrationBodies } from './migration-execution'\nimport { prepareMigrationPrivileges, grantUnmanagedObjects } from './migration-privileges'\nimport { pinnedMigrationDatabase, type MigrationDatabase } from './migration-connection'\nimport { drizzle } from 'drizzle-orm/postgres-js'\nimport postgres from 'postgres'\nimport { sql } from 'drizzle-orm'\nimport { fileURLToPath } from 'node:url'\nimport { RLS_POLICY_SQL } from './rls'\nimport { REPORT_VIEWS_SQL } from './views'\nimport { STATS_SQL, STATS_HIGH_VOLUME_TABLES } from './stats'\nimport { BUILTIN_ROLES, PERMISSION_CATALOGUE } from './schema'\nimport { installStandardRiskLibrary } from './risk-library-install'\nimport { riskMigrationTasks } from './risk-migration-readiness'\nimport {\n  readMigrationFiles,\n  validateMigrationState,\n  type MigrationTrackerRow,\n} from './migration-state'\n\nconst MIGRATIONS_FOLDER = fileURLToPath(new URL('../drizzle', import.meta.url))\nconst MIGRATION_FILES = readMigrationFiles(MIGRATIONS_FOLDER)\nconst MIGRATION_CUTOVER_AT = 1783884000000\nconst ROLE_NAME = /^[a-z_][a-z0-9_]{0,62}$/\n\nfunction roleIdentifier(role: string): string {\n  if (!ROLE_NAME.test(role)) throw new Error(`Invalid database role name: ${role}`)\n  return `\"${role}\"`\n}\n\nfunction firstRow<T = Record<string, unknown>>(result: unknown): T | undefined {\n  const rows = (result as { rows?: T[] }).rows ?? (result as T[])\n  return rows[0]\n}\n\nasync function verifyMigrationTracker(db: MigrationDatabase, requireComplete: boolean) {\n  const appTable = firstRow<{ exists: string | null }>(\n    await db.execute(sql`select to_regclass('public.tenants')::text as exists`),\n  )?.exists\n  if (!appTable) {\n    if (requireComplete) throw new Error('Migrations completed without creating public.tenants')\n    console.log('  Fresh database detected; the full migration journal will run')\n    return\n  }\n\n  const trackerTable = firstRow<{ exists: string | null }>(\n    await db.execute(sql`select to_regclass('drizzle.__drizzle_migrations')::text as exists`),\n  )?.exists\n  if (!trackerTable) {\n    throw new Error(\n      'Existing BeaconHS schema has no drizzle migration tracker. Refusing to mark migrations applied without validating the physical schema.',\n    )\n  }\n\n  const rows = (await db.execute(sql`\n    select hash, created_at\n    from \"drizzle\".\"__drizzle_migrations\"\n    order by created_at\n  `)) as unknown as Array<{ hash: string; created_at: MigrationTrackerRow['createdAt'] }>\n  const state = validateMigrationState(\n    MIGRATION_FILES,\n    rows.map((row) => ({ hash: row.hash, createdAt: row.created_at })),\n    { allowLegacyBefore: process.env.FEATURE_CANDIDATE_VERIFIED === 'true' ? undefined : MIGRATION_CUTOVER_AT, requireComplete },\n  )\n  console.log(\n    `  Migration ledger valid: ${state.applied.length} applied, ${state.pending.length} pending, ${state.unknownTrackerRows} historical`,\n  )\n}\n\nasync function assertKioskPinHashes(db: MigrationDatabase) {\n  type CountRow = { count: number }\n  const tenantCount = firstRow<CountRow>(\n    await db.execute(sql`\n      select count(*)::integer as count\n      from tenants\n      where kiosk_pin is not null\n        and kiosk_pin <> ''\n        and kiosk_pin not like 'bhs_pin_scrypt_v1$%'\n    `),\n  )?.count\n  const stationCount = firstRow<CountRow>(\n    await db.execute(sql`\n      select count(*)::integer as count\n      from equipment_station_settings\n      where station_pin is not null\n        and station_pin <> ''\n        and station_pin not like 'bhs_pin_scrypt_v1$%'\n    `),\n  )?.count\n\n  if ((tenantCount ?? 0) > 0 || (stationCount ?? 0) > 0) {\n    throw new Error(\n      `Unhashed kiosk PIN invariant failed (${tenantCount ?? 0} tenant, ${stationCount ?? 0} station). Refusing to deploy until the explicit PIN migration is completed.`,\n    )\n  }\n  console.log('✔ Kiosk PIN hash invariant verified')\n}\n\nasync function convergeRolePermissions(db: MigrationDatabase) {\n  const fullCatalogueJson = JSON.stringify(PERMISSION_CATALOGUE)\n\n  await db.transaction(async (transaction) => {\n    const tx = transaction as unknown as MigrationDatabase\n    // Clean cutover: remove retired/unknown keys from built-in and custom roles\n    // before adding the current built-in baseline. This prevents deleted\n    // capabilities from surviving indefinitely as inert authorization data.\n    await tx.execute(sql`\n      update \"roles\"\n      set \"permissions\" = (\n            select coalesce(jsonb_agg(current_permission.\"permission\" order by current_permission.\"permission\"), '[]'::jsonb)\n            from jsonb_array_elements_text(\"roles\".\"permissions\") as current_permission(\"permission\")\n            where ${fullCatalogueJson}::jsonb ? current_permission.\"permission\"\n          ),\n          \"updated_at\" = now()\n      where exists (\n        select 1\n        from jsonb_array_elements_text(\"roles\".\"permissions\") as current_permission(\"permission\")\n        where not (${fullCatalogueJson}::jsonb ? current_permission.\"permission\")\n      )\n    `)\n\n    await tx.execute(sql`\n      update \"roles\"\n      set \"permissions\" = ${fullCatalogueJson}::jsonb,\n          \"updated_at\" = now()\n      where \"key\" = 'tenant_admin'\n        and \"is_built_in\" = true\n        and \"permissions\" <> ${fullCatalogueJson}::jsonb\n    `)\n\n    for (const [key, def] of Object.entries(BUILTIN_ROLES)) {\n      if (key === 'tenant_admin') continue\n      const baselineJson = JSON.stringify(def.permissions)\n      await tx.execute(sql`\n        update \"roles\"\n        set \"permissions\" = (\n              select coalesce(jsonb_agg(\"permission\" order by \"permission\"), '[]'::jsonb)\n              from (\n                select distinct \"permission\"\n                from (\n                  select jsonb_array_elements_text(\"roles\".\"permissions\") as \"permission\"\n                  union\n                  select jsonb_array_elements_text(${baselineJson}::jsonb) as \"permission\"\n                ) as combined_permissions\n              ) as deduped_permissions\n            ),\n            \"updated_at\" = now()\n        where \"key\" = ${key}\n          and \"is_built_in\" = true\n          and exists (\n            select 1\n            from jsonb_array_elements_text(${baselineJson}::jsonb) as baseline(\"permission\")\n            where not (\"roles\".\"permissions\" ? baseline.\"permission\")\n          )\n      `)\n    }\n  })\n\n  console.log('✔ Built-in role permissions backfilled')\n}\n\nasync function assumeOwnerRole(migrationDb: MigrationDatabase, ownerRole: string) {\n  const membership = firstRow<{\n    login_role: string\n    can_assume: boolean\n    login_super: boolean\n    login_bypass_rls: boolean\n    owner_can_login: boolean\n    owner_super: boolean\n    owner_bypass_rls: boolean\n  }>(\n    await migrationDb.execute(sql`\n      select\n        session_user as login_role,\n        pg_has_role(session_user, ${ownerRole}, 'MEMBER') as can_assume,\n        login.rolsuper as login_super,\n        login.rolbypassrls as login_bypass_rls,\n        owner.rolcanlogin as owner_can_login,\n        owner.rolsuper as owner_super,\n        owner.rolbypassrls as owner_bypass_rls\n      from pg_roles login\n      join pg_roles owner on owner.rolname = ${ownerRole}\n      where login.rolname = session_user\n    `),\n  )\n  if (!membership) throw new Error(`Database owner role ${ownerRole} does not exist`)\n  if (!membership.can_assume) {\n    throw new Error(`Migration login ${membership.login_role} cannot SET ROLE ${ownerRole}`)\n  }\n  if (membership.login_super || membership.login_bypass_rls) {\n    throw new Error('Migration login must not be SUPERUSER or BYPASSRLS')\n  }\n  if (membership.owner_can_login || membership.owner_super || membership.owner_bypass_rls) {\n    throw new Error(`Owner role ${ownerRole} must be NOLOGIN, NOSUPERUSER, and NOBYPASSRLS`)\n  }\n\n  await migrationDb.execute(sql.raw(`SET ROLE ${roleIdentifier(ownerRole)}`))\n}\n\nasync function assertDatabaseRoles(\n  migrationDb: MigrationDatabase,\n  runtimeDb: MigrationDatabase,\n  maintenanceDb: MigrationDatabase,\n  expectedOwner: string,\n  expectedBackup: string,\n) {\n  const migration = firstRow<{ login_role: string; owner_role: string }>(\n    await migrationDb.execute(sql`select session_user as login_role, current_user as owner_role`),\n  )\n  const runtime = firstRow<{\n    role: string\n    is_super: boolean\n    bypass_rls: boolean\n    owner_member: boolean\n  }>(\n    await runtimeDb.execute(sql`\n      select\n        current_user as role,\n        rolsuper as is_super,\n        rolbypassrls as bypass_rls,\n        pg_has_role(current_user, ${expectedOwner}, 'MEMBER') as owner_member\n      from pg_roles\n      where rolname = current_user\n    `),\n  )\n  const maintenance = firstRow<{\n    role: string\n    is_super: boolean\n    bypass_rls: boolean\n    owner_member: boolean\n  }>(\n    await maintenanceDb.execute(sql`\n      select\n        current_user as role,\n        rolsuper as is_super,\n        rolbypassrls as bypass_rls,\n        pg_has_role(current_user, ${expectedOwner}, 'MEMBER') as owner_member\n      from pg_roles\n      where rolname = current_user\n    `),\n  )\n  const backup = firstRow<{\n    role: string\n    can_login: boolean\n    is_super: boolean\n    bypass_rls: boolean\n    owner_member: boolean\n    read_only: boolean\n  }>(\n    await migrationDb.execute(sql`\n      select\n        rolname as role,\n        rolcanlogin as can_login,\n        rolsuper as is_super,\n        rolbypassrls as bypass_rls,\n        pg_has_role(rolname, ${expectedOwner}, 'MEMBER') as owner_member,\n        coalesce(rolconfig @> array['default_transaction_read_only=on']::text[], false) as read_only\n      from pg_roles\n      where rolname = ${expectedBackup}\n    `),\n  )\n  if (!migration || !runtime || !maintenance || !backup) {\n    throw new Error('Unable to resolve database roles for migration preflight')\n  }\n  if (migration.owner_role !== expectedOwner) {\n    throw new Error(\n      `Migration login ${migration.login_role} did not assume expected owner role ${expectedOwner}`,\n    )\n  }\n  const distinctRoles = new Set([\n    migration.login_role,\n    migration.owner_role,\n    runtime.role,\n    maintenance.role,\n    backup.role,\n  ])\n  if (distinctRoles.size !== 5) {\n    throw new Error(\n      'Migration login, owner, runtime, maintenance, and backup roles must all be distinct',\n    )\n  }\n  if (runtime.is_super || runtime.bypass_rls || runtime.owner_member) {\n    throw new Error(\n      `Runtime role ${runtime.role} must be NOSUPERUSER, NOBYPASSRLS, and not a member of ${expectedOwner}`,\n    )\n  }\n  if (maintenance.is_super || !maintenance.bypass_rls || maintenance.owner_member) {\n    throw new Error(\n      `Maintenance role ${maintenance.role} must be non-superuser BYPASSRLS and not a member of ${expectedOwner}`,\n    )\n  }\n  if (\n    !backup.can_login ||\n    backup.is_super ||\n    !backup.bypass_rls ||\n    backup.owner_member ||\n    !backup.read_only\n  ) {\n    throw new Error(\n      `Backup role ${backup.role} must be LOGIN, non-superuser BYPASSRLS, non-owner, and default_transaction_read_only=on`,\n    )\n  }\n\n  const tableOwner = firstRow<{ owner: string | null }>(\n    await migrationDb.execute(sql`\n      select pg_get_userbyid(c.relowner) as owner\n      from pg_class c\n      join pg_namespace n on n.oid = c.relnamespace\n      where n.nspname = 'public' and c.relname = 'tenants'\n    `),\n  )?.owner\n  if (tableOwner && tableOwner !== expectedOwner) {\n    throw new Error(`Existing app tables are owned by ${tableOwner}; expected ${expectedOwner}`)\n  }\n  console.log(\n    `✔ Database role preflight passed (${migration.login_role} → ${expectedOwner}; runtime ${runtime.role}; maintenance ${maintenance.role}; backup ${backup.role})`,\n  )\n\n  return {\n    runtimeRole: runtime.role,\n    maintenanceRole: maintenance.role,\n    backupRole: backup.role,\n  }\n}\n\nasync function applyRuntimeGrants(\n  db: MigrationDatabase,\n  ownerRole: string,\n  runtimeRole: string,\n  maintenanceRole: string,\n  backupRole: string,\n) {\n  const owner = roleIdentifier(ownerRole)\n  const runtime = roleIdentifier(runtimeRole)\n  const maintenance = roleIdentifier(maintenanceRole)\n  const backup = roleIdentifier(backupRole)\n  await db.transaction(async (transaction) => {\n    const tx = transaction as unknown as MigrationDatabase\n    for (const statement of [\n      `REVOKE ALL ON SCHEMA security FROM PUBLIC`,\n      `REVOKE CREATE ON SCHEMA security FROM ${runtime}, ${maintenance}, ${backup}`,\n      `GRANT USAGE ON SCHEMA security TO ${runtime}`,\n      `REVOKE ALL ON FUNCTION security.person_allows_scope(uuid, uuid) FROM PUBLIC`,\n      `GRANT EXECUTE ON FUNCTION security.person_allows_scope(uuid, uuid) TO ${runtime}`,\n      `REVOKE CREATE ON SCHEMA public FROM PUBLIC, ${runtime}, ${maintenance}`,\n      `REVOKE CREATE ON SCHEMA public FROM ${backup}`,\n      `GRANT USAGE ON SCHEMA public TO ${runtime}, ${maintenance}, ${backup}`,\n      `GRANT USAGE ON SCHEMA drizzle TO ${backup}`,\n      `REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA drizzle FROM ${backup}`,\n      `GRANT SELECT ON ALL TABLES IN SCHEMA drizzle TO ${backup}`,\n      `REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA drizzle FROM ${backup}`,\n      `GRANT SELECT ON ALL SEQUENCES IN SCHEMA drizzle TO ${backup}`,\n      `ALTER DEFAULT PRIVILEGES FOR ROLE ${owner} IN SCHEMA drizzle GRANT SELECT ON TABLES TO ${backup}`,\n      `ALTER DEFAULT PRIVILEGES FOR ROLE ${owner} IN SCHEMA drizzle GRANT SELECT ON SEQUENCES TO ${backup}`,\n    ]) {\n      await tx.execute(sql.raw(statement))\n    }\n  })\n  console.log(\n    `✔ Least-privilege grants applied (runtime ${runtimeRole}; maintenance ${maintenanceRole}; backup ${backupRole})`,\n  )\n  await grantUnmanagedObjects(db, ownerRole, runtimeRole, maintenanceRole, backupRole)\n}\n\nasync function applyRlsPolicies(db: MigrationDatabase) {\n  const optionalRows = (await db.execute(sql`\n    select to_regclass('public.risk_template_families') is not null as families,\n           to_regclass('public.risk_assessment_versions') is not null as versions\n  `)) as unknown as Array<{ families: boolean; versions: boolean }>\n  const { tables } = riskMigrationTasks(optionalRows[0])\n  await db.transaction(async (transaction) => {\n    const tx = transaction as unknown as MigrationDatabase\n    for (const table of tables) {\n      try {\n        await tx.execute(sql.raw(RLS_POLICY_SQL(table)))\n      } catch (error) {\n        throw new Error(`RLS policy installation failed for ${table}`, { cause: error })\n      }\n    }\n  })\n  console.log(`✔ RLS applied atomically (${tables.length} tables)`)\n}\n\nasync function applyPlannerStatistics(db: MigrationDatabase) {\n  await db.transaction(async (transaction) => {\n    const tx = transaction as unknown as MigrationDatabase\n    for (const statement of STATS_SQL) await tx.execute(sql.raw(statement))\n  })\n  for (const table of STATS_HIGH_VOLUME_TABLES) {\n    await db.execute(sql.raw(`ANALYZE ${table};`))\n  }\n  console.log(`✔ Statistics applied (${STATS_SQL.length} targets)`)\n}\n\nasync function applyReportingViews(db: MigrationDatabase) {\n  await db.transaction(async (transaction) => {\n    const tx = transaction as unknown as MigrationDatabase\n    for (const viewSql of REPORT_VIEWS_SQL) await tx.execute(sql.raw(viewSql))\n  })\n  console.log(`✔ Views applied atomically (${REPORT_VIEWS_SQL.length} statements)`)\n}\n\nasync function main() {\n  const devGate = process.env.FEATURE_CANDIDATE_VERIFIED === 'true'\n    ? await loadDevMigrationGate(MIGRATIONS_FOLDER) : null\n  // DDL uses a dedicated unpooled login that can SET ROLE to a NOLOGIN owner.\n  // Runtime and cross-tenant maintenance are distinct, non-owner logins.\n  const migrationUrl = process.env.MIGRATION_DATABASE_URL\n  const runtimeUrl = process.env.DATABASE_URL\n  const maintenanceUrl = process.env.SUPERADMIN_DATABASE_URL\n  const ownerRole = process.env.DATABASE_OWNER_ROLE ?? 'beaconhs_owner'\n  const backupRole = process.env.DATABASE_BACKUP_ROLE ?? 'beaconhs_backup'\n  roleIdentifier(ownerRole)\n  roleIdentifier(backupRole)\n  if (!migrationUrl) throw new Error('MIGRATION_DATABASE_URL is required for migrations')\n  if (!runtimeUrl) throw new Error('DATABASE_URL is required for runtime-role validation')\n  if (!maintenanceUrl) {\n    throw new Error('SUPERADMIN_DATABASE_URL is required for cross-tenant migration maintenance')\n  }\n\n  const migrationClient = postgres(migrationUrl, {\n    max: 1,\n    idle_timeout: 0,\n    max_lifetime: 0,\n    prepare: false,\n    // Idempotent policy/view installation deliberately uses DROP ... IF EXISTS\n    // across hundreds of objects. PostgreSQL emits one NOTICE for every absent\n    // object; suppress those protocol notices so deploy logs retain the explicit\n    // phase summaries and actionable warnings/errors instead of thousands of\n    // expected \"does not exist, skipping\" records.\n    onnotice: () => undefined,\n  })\n  const runtimeClient = postgres(runtimeUrl, { max: 1, prepare: false })\n  const maintenanceClient = postgres(maintenanceUrl, { max: 1, prepare: false })\n  // Keep SET ROLE and the advisory lock on one reserved physical connection.\n  const reserved = await migrationClient.reserve()\n  const migrationDb = pinnedMigrationDatabase(reserved)\n  const runtimeDb = drizzle(runtimeClient)\n  const maintenanceDb = drizzle(maintenanceClient)\n  let lockAcquired = false\n\n  try {\n    await assumeOwnerRole(migrationDb, ownerRole)\n    const roles = await assertDatabaseRoles(\n      migrationDb,\n      runtimeDb,\n      maintenanceDb,\n      ownerRole,\n      backupRole,\n    )\n    await migrationDb.execute(sql`select pg_advisory_lock(hashtext('beaconhs:schema-migration'))`)\n    lockAcquired = true\n    if (devGate) await devGate.before(migrationDb)\n\n    console.log('▶ Validating migration ledger…')\n    await verifyMigrationTracker(migrationDb, false)\n\n    console.log('▶ Running drizzle migrations…')\n    await prepareMigrationPrivileges(\n      migrationDb,\n      ownerRole,\n      roles.runtimeRole,\n      roles.maintenanceRole,\n      roles.backupRole,\n    )\n    await executePendingMigrations(\n      migrationDb,\n      loadMigrationBodies(MIGRATIONS_FOLDER, MIGRATION_FILES),\n      { allowLegacyBefore: devGate ? undefined : MIGRATION_CUTOVER_AT },\n    )\n    await verifyMigrationTracker(migrationDb, true)\n\n    console.log('▶ Applying RLS policies…')\n    await applyRlsPolicies(migrationDb)\n\n    console.log('▶ Applying least-privilege runtime grants…')\n    await applyRuntimeGrants(\n      migrationDb,\n      ownerRole,\n      roles.runtimeRole,\n      roles.maintenanceRole,\n      roles.backupRole,\n    )\n\n    console.log('▶ Verifying security data invariants…')\n    await assertKioskPinHashes(maintenanceDb)\n\n    const riskSchemaRows = (await migrationDb.execute(sql`\n      select to_regclass('public.risk_template_families') is not null as families,\n             to_regclass('public.risk_assessment_versions') is not null as versions\n    `)) as unknown as Array<{ families: boolean; versions: boolean }>\n    if (riskMigrationTasks(riskSchemaRows[0]).installRiskLibrary) {\n      console.log('▶ Installing missing standard Risk Library templates…')\n      await installStandardRiskLibrary(maintenanceDb)\n    } else {\n      console.log('  Risk Library installation deferred until prepared migrations are approved')\n    }\n\n    console.log('▶ Converging role permissions…')\n    await convergeRolePermissions(maintenanceDb)\n\n    console.log('▶ Applying planner statistics targets…')\n    await applyPlannerStatistics(migrationDb)\n\n    console.log('▶ Applying reporting views…')\n    await applyReportingViews(migrationDb)\n    await grantUnmanagedObjects(\n      migrationDb,\n      ownerRole,\n      roles.runtimeRole,\n      roles.maintenanceRole,\n      roles.backupRole,\n    )\n    if (devGate) await devGate.after(migrationDb)\n  } finally {\n    if (lockAcquired) {\n      try {\n        await migrationDb.execute(\n          sql`select pg_advisory_unlock(hashtext('beaconhs:schema-migration'))`,\n        )\n      } catch (error) {\n        console.warn('Migration advisory lock will be released when the connection closes', error)\n      }\n    }\n    reserved.release()\n    await Promise.all([migrationClient.end(), runtimeClient.end(), maintenanceClient.end()])\n  }\n}\n\nmain().catch((err) => {\n  console.error(err)\n  process.exitCode = 1\n})\n",".github/workflows/deploy-dev.yml":"name: Deploy (dev)\n\n# Standard dev deployment, called by the CI workflow after its gate job passes\n# for the same main-branch commit: build and push the commit's image, run the\n# forward-only database migrations, point the Dokploy compose at the new image\n# digest, redeploy, and wait for exact-SHA readiness. Images are built on\n# GitHub-hosted runners; migration and deployment run on the Dokploy runner.\n# All deployment-specific values live in repository secrets.\n\non:\n  workflow_call:\n    inputs:\n      ci_gate_completed:\n        description: Set only by the CI caller after its gate job succeeds\n        required: false\n        type: boolean\n        default: false\n      source_sha:\n        description: Verified immutable source SHA for an approved feature candidate\n        required: false\n        type: string\n        default: ''\n      image_digest:\n        description: Verified immutable image digest for an approved feature candidate\n        required: false\n        type: string\n        default: ''\n      release_evidence_sha256:\n        description: Owner-approved DEV backup and release evidence checksum\n        required: false\n        type: string\n        default: ''\n      feature_candidate_verified:\n        description: Set only by the V1.4 candidate verification workflow\n        required: false\n        type: boolean\n        default: false\n    secrets:\n      MAIN_MIGRATION_DATABASE_URL:\n        description: Canonical normal-main migrator connection on infra-net\n        required: true\n      MAIN_DATABASE_URL:\n        description: Canonical normal-main runtime connection on infra-net\n        required: true\n      MAIN_SUPERADMIN_DATABASE_URL:\n        description: Canonical normal-main maintenance connection on infra-net\n        required: true\n      DEV_MIGRATION_DATABASE_URL:\n        description: Verified V1.4 candidate migrator connection on the DEV-private network\n        required: true\n      DEV_DATABASE_URL:\n        description: Verified V1.4 candidate runtime connection on the DEV-private network\n        required: true\n      DEV_SUPERADMIN_DATABASE_URL:\n        description: Verified V1.4 candidate maintenance connection on the DEV-private network\n        required: true\n      # The remaining deployment secrets are inherited by the caller as needed.\n      DEV_APP_URL:\n        required: false\n      DEV_ATTACHMENT_CAPABILITY_SECRET:\n        required: false\n      DEV_BETTER_AUTH_SECRET:\n        required: false\n      DEV_BACKUP_DATABASE_URL:\n        required: false\n      DEV_REDIS_URL:\n        required: false\n      MAIN_REDIS_URL:\n        required: false\n      DEV_R2_ENDPOINT:\n        required: false\n      DEV_R2_ACCESS_KEY_ID:\n        required: false\n      DEV_R2_SECRET_ACCESS_KEY:\n        required: false\n      DEV_R2_BUCKET:\n        required: false\n      DEV_R2_PRIVATE_BUCKET_CONFIRMED:\n        required: false\n      DOKPLOY_COMPOSE_ID:\n        required: false\n      DOKPLOY_RESOLVE_IP:\n        required: false\n      DOKPLOY_TOKEN:\n        required: false\n      DOKPLOY_URL:\n        required: false\n      R2_ACCESS_KEY_ID:\n        required: false\n      R2_BUCKET:\n        required: false\n      R2_ENDPOINT:\n        required: false\n      R2_PRIVATE_BUCKET_CONFIRMED:\n        required: false\n      R2_SECRET_ACCESS_KEY:\n        required: false\n      SENTRY_DSN:\n        required: false\n      VAPID_PRIVATE_KEY:\n        required: false\n      VAPID_PUBLIC_KEY:\n        required: false\n      VAPID_SUBJECT:\n        required: false\n\nconcurrency:\n  group: deploy-dev\n  cancel-in-progress: false\n\npermissions:\n  contents: read\n  packages: read\n\nenv:\n  IMAGE_NAME: ghcr.io/satho82/beaconhs\n  COLLABORA_IMAGE: collabora/code:26.04.2.1.1@sha256:df33af88c59e26b7335ea98d91e65f1edf13f33369ce6115941b8d59d3409cb5\n  # The migration runtime is pinned separately from the application image so\n  # it can be verified before the forward-only migration command is reached.\n  MIGRATION_NODE_IMAGE: node:24-bookworm@sha256:64af3819f9275802414d7cdc38c27e9d82bd564dec4d4da87d008255d36c63b4\n  DEPLOY_UTILITY_IMAGE: alpine:3@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b\n\njobs:\n  build:\n    if: inputs.source_sha == ''\n    permissions:\n      contents: read\n      packages: write\n    runs-on: ubuntu-24.04\n    timeout-minutes: 60\n    outputs:\n      image_digest: ${{ steps.build-image.outputs.digest }}\n    steps:\n      - name: Require the gated main-branch CI caller\n        env:\n          EVENT_NAME: ${{ github.event_name }}\n          REF: ${{ github.ref }}\n          CI_GATE_COMPLETED: ${{ inputs.ci_gate_completed }}\n        run: |\n          set -euo pipefail\n          if [ \"$REF\" != refs/heads/main ] || [ \"$CI_GATE_COMPLETED\" != true ] \\\n            || { [ \"$EVENT_NAME\" != push ] && [ \"$EVENT_NAME\" != workflow_dispatch ]; }; then\n            echo \"::error::Dev deployment must be called by the main-branch CI workflow after its gate job succeeds\"\n            exit 1\n          fi\n      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7\n        with:\n          persist-credentials: false\n      - name: Reject stale main-branch workflow runs\n        env:\n          GITHUB_TOKEN: ${{ github.token }}\n        run: scripts/ci/require-current-main.sh\n      - uses: docker/setup-buildx-action@bb05f3f5519dd87d3ba754cc423b652a5edd6d2c # v4\n      - uses: docker/login-action@af1e73f918a031802d376d3c8bbc3fe56130a9b0 # v4\n        with:\n          registry: ghcr.io\n          username: ${{ github.actor }}\n          password: ${{ secrets.GITHUB_TOKEN }}\n      - id: build-image\n        uses: docker/build-push-action@53b7df96c91f9c12dcc8a07bcb9ccacbed38856a # v7\n        with:\n          context: .\n          platforms: linux/amd64\n          push: true\n          tags: ${{ env.IMAGE_NAME }}:${{ github.sha }}\n          cache-from: type=gha\n          build-args: |\n            NEXT_PUBLIC_SENTRY_DSN=${{ secrets.SENTRY_DSN }}\n            DEPLOYMENT_VERSION=${{ github.sha }}\n          # Next generates a fresh Server Actions encryption key for this image.\n          # Every replica of the release must use the same immutable digest.\n          # ignore-error: the GHA cache backend intermittently fails the blob\n          # write (\"error writing layer blob: not_found\") AFTER the image is\n          # already pushed — don't let a cache hiccup fail the build/deploy.\n          cache-to: type=gha,mode=max,ignore-error=true\n\n  deploy:\n    needs: [build]\n    # Main deployments require the existing build. A V1.4 deployment can only\n    # use the two immutable values emitted by the dedicated verifier workflow.\n    if: >-\n      always() && (\n        (inputs.source_sha == '' && needs.build.result == 'success') ||\n        (inputs.source_sha != '' && inputs.image_digest != '' &&\n          inputs.feature_candidate_verified)\n      )\n    permissions:\n      contents: read\n      packages: read\n    runs-on: [self-hosted, dokploy]\n    timeout-minutes: 45\n    env:\n      IMAGE_DIGEST: ${{ inputs.image_digest || needs.build.outputs.image_digest }}\n      DEPLOY_SOURCE_SHA: ${{ inputs.source_sha || github.sha }}\n      DEPLOY_IMAGE_NAME: ${{ inputs.source_sha != '' && 'ghcr.io/satho82/uvanoo-staging-private' || 'ghcr.io/satho82/beaconhs' }}\n      CALLER_WORKFLOW_REF: ${{ github.workflow_ref }}\n      DEPLOY_GOVERNANCE_SHA: ${{ github.workflow_sha }}\n      # The candidate database is isolated from the normal main deployment\n      # stack. Keep the main path on infra-net and use the DEV-private alias\n      # only after the candidate verifier has approved the immutable input.\n      MIGRATION_DOCKER_NETWORK: ${{ inputs.feature_candidate_verified && 'uvanoo-dev-private' || 'infra-net' }}\n      RUNTIME_DOCKER_NETWORK: ${{ inputs.feature_candidate_verified && 'uvanoo-dev-runtime' || 'infra-net' }}\n      DOKPLOY_COMPOSE_ID: ${{ inputs.feature_candidate_verified && 'wYb0LxLQrvj2FPI21i-Oj' || secrets.DOKPLOY_COMPOSE_ID }}\n      EXPECTED_DOKPLOY_STACK: ${{ inputs.feature_candidate_verified && 'uvanoo-v1-4-dev-gniriv' || 'beaconhs-ib9ybf' }}\n      EXPECTED_APP_HOST: ${{ inputs.feature_candidate_verified && 'dev.uvanoo.com' || 'portal.uvanoo.com' }}\n      MIGRATION_DATABASE_URL: ${{ inputs.feature_candidate_verified && secrets.DEV_MIGRATION_DATABASE_URL || secrets.MAIN_MIGRATION_DATABASE_URL }}\n      DATABASE_URL: ${{ inputs.feature_candidate_verified && secrets.DEV_DATABASE_URL || secrets.MAIN_DATABASE_URL }}\n      SUPERADMIN_DATABASE_URL: ${{ inputs.feature_candidate_verified && secrets.DEV_SUPERADMIN_DATABASE_URL || secrets.MAIN_SUPERADMIN_DATABASE_URL }}\n      REDIS_URL: ${{ inputs.feature_candidate_verified && secrets.DEV_REDIS_URL || secrets.MAIN_REDIS_URL }}\n      EXPECTED_MIGRATION_HOST: ${{ inputs.feature_candidate_verified && 'uvanoo-dev-postgres' || 'beaconhs-postgres' }}\n      EXPECTED_DATABASE_NAME: ${{ inputs.feature_candidate_verified && 'beaconhs' || 'beaconhs' }}\n    steps:\n      # The deploy runner shares storage with Dokploy. Keep stale build cache\n      # and superseded images from exhausting the host and taking the Dokploy\n      # API offline. Active service images and all volumes are preserved.\n      - name: Reclaim stale deployment-runner storage\n        run: |\n          set -euo pipefail\n          echo \"Storage before cleanup:\"\n          df -h /\n          docker system df\n          docker builder prune --force --filter until=168h\n          docker image prune --all --force --filter until=168h\n          echo \"Storage after cleanup:\"\n          df -h /\n          available_kb=\"$(df -Pk / | awk 'NR==2 {print $4}')\"\n          if ! [[ \"$available_kb\" =~ ^[0-9]+$ ]] || [ \"$available_kb\" -lt 2097152 ]; then\n            echo \"::error::The Dokploy runner requires at least 2 GiB free after safe Docker cleanup\"\n            exit 1\n          fi\n      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7\n        with:\n          ref: ${{ env.DEPLOY_SOURCE_SHA }}\n          persist-credentials: false\n      # Relative reusable calls resolve at the caller workflow commit. Pin the\n      # compose separately so the frozen application checkout cannot select it.\n      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7\n        with:\n          ref: ${{ env.DEPLOY_GOVERNANCE_SHA }}\n          path: .deployment-governance\n          persist-credentials: false\n      - name: Verify deployment governance source\n        env:\n          FEATURE_CANDIDATE_VERIFIED: ${{ inputs.feature_candidate_verified }}\n        run: |\n          set -euo pipefail\n          if ! [[ \"$DEPLOY_GOVERNANCE_SHA\" =~ ^[0-9a-f]{40}$ ]]; then\n            echo '::error::Deployment governance must have a full immutable workflow SHA'\n            exit 1\n          fi\n          test \"$(git -C .deployment-governance rev-parse HEAD)\" = \"$DEPLOY_GOVERNANCE_SHA\"\n          if [ \"$FEATURE_CANDIDATE_VERIFIED\" = true ]; then\n            caller_path=.github/workflows/deploy-v1.4-dev-candidate.yml\n          else\n            caller_path=.github/workflows/ci.yml\n            test \"$DEPLOY_GOVERNANCE_SHA\" = \"$DEPLOY_SOURCE_SHA\"\n          fi\n          test \"$CALLER_WORKFLOW_REF\" = \"$GITHUB_REPOSITORY/$caller_path@$GITHUB_REF\"\n          grep -Fx '    uses: ./.github/workflows/deploy-dev.yml' \".deployment-governance/$caller_path\" >/dev/null\n          compose_blob=\"$(git -C .deployment-governance rev-parse \"$DEPLOY_GOVERNANCE_SHA:deploy/dokploy-dev.compose.yaml\")\"\n          test \"$(git hash-object .deployment-governance/deploy/dokploy-dev.compose.yaml)\" = \"$compose_blob\"\n          printf 'Deployment governance SHA: %s\\nCompose blob: %s\\n' \"$DEPLOY_GOVERNANCE_SHA\" \"$compose_blob\" >> \"$GITHUB_STEP_SUMMARY\"\n      - name: Validate verified deployment identity\n        run: |\n          set -euo pipefail\n          if ! [[ \"$DEPLOY_SOURCE_SHA\" =~ ^[0-9a-f]{40}$ ]]; then\n            echo \"::error::Deployment source must be a full lowercase commit SHA\"\n            exit 1\n          fi\n          if [ \"${{ inputs.source_sha }}\" != '' ] \\\n            && { [ \"${{ inputs.feature_candidate_verified }}\" != true ] \\\n              || [ \"${{ inputs.image_digest }}\" = '' ]; }; then\n            echo \"::error::Feature deployments require the verified candidate workflow\"\n            exit 1\n          fi\n          if [ \"${{ inputs.source_sha }}\" != '' ] \\\n            && [[ \"$CALLER_WORKFLOW_REF\" != \"$GITHUB_REPOSITORY/.github/workflows/deploy-v1.4-dev-candidate.yml@\"* ]]; then\n            echo \"::error::Feature deployments may only be called by the V1.4 candidate verifier workflow\"\n            exit 1\n          fi\n          test \"$(git rev-parse HEAD)\" = \"$DEPLOY_SOURCE_SHA\"\n      - name: Validate immutable build output\n        run: |\n          set -euo pipefail\n          if ! [[ \"$IMAGE_DIGEST\" =~ ^sha256:[0-9a-f]{64}$ ]]; then\n            echo \"::error::The image build did not return a canonical sha256 digest\"\n            exit 1\n          fi\n          echo \"Deploying immutable image ${DEPLOY_IMAGE_NAME}@${IMAGE_DIGEST} from $DEPLOY_SOURCE_SHA\"\n\n      - name: Configure TLS-preserving Dokploy split-DNS resolution\n        env:\n          DOKPLOY_URL: ${{ secrets.DOKPLOY_URL }}\n          DOKPLOY_RESOLVE_IP: ${{ secrets.DOKPLOY_RESOLVE_IP }}\n        run: |\n          set -euo pipefail\n          dokploy_host=\"${DOKPLOY_URL#https://}\"\n          if [ \"$dokploy_host\" = \"$DOKPLOY_URL\" ] \\\n            || [ \"${#dokploy_host}\" -gt 253 ] \\\n            || ! [[ \"$dokploy_host\" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]]; then\n            echo \"::error::DOKPLOY_URL must be an HTTPS origin with a DNS hostname, no port, path, query, fragment, or trailing slash\"\n            exit 1\n          fi\n          if ! [[ \"$DOKPLOY_RESOLVE_IP\" =~ ^(0|[1-9][0-9]{0,2})\\.(0|[1-9][0-9]{0,2})\\.(0|[1-9][0-9]{0,2})\\.(0|[1-9][0-9]{0,2})$ ]]; then\n            echo \"::error::DOKPLOY_RESOLVE_IP must be a canonical private IPv4 address\"\n            exit 1\n          fi\n          IFS=. read -r ip_a ip_b ip_c ip_d <<< \"$DOKPLOY_RESOLVE_IP\"\n          for octet in \"$ip_a\" \"$ip_b\" \"$ip_c\" \"$ip_d\"; do\n            if [ \"$((10#$octet))\" -gt 255 ]; then\n              echo \"::error::DOKPLOY_RESOLVE_IP must be a canonical private IPv4 address\"\n              exit 1\n            fi\n          done\n          if ! (( ip_a == 10 \\\n            || (ip_a == 172 && ip_b >= 16 && ip_b <= 31) \\\n            || (ip_a == 192 && ip_b == 168) )); then\n            echo \"::error::DOKPLOY_RESOLVE_IP must be an RFC 1918 private IPv4 address\"\n            exit 1\n          fi\n          printf 'DOKPLOY_CURL_RESOLVE=%s\\n' \\\n            \"${dokploy_host}:443:${DOKPLOY_RESOLVE_IP}\" >> \"$GITHUB_ENV\"\n\n      # Dokploy remains the preferred control plane. If its API credential is\n      # unavailable, identify the one existing BeaconHS stack from the Swarm\n      # service specs and perform an image-only rollout later. That fallback\n      # preserves Dokploy's routing labels and every existing service setting.\n      - name: Resolve the dev deployment target\n        env:\n          DOKPLOY_URL: ${{ secrets.DOKPLOY_URL }}\n          DOKPLOY_TOKEN: ${{ secrets.DOKPLOY_TOKEN }}\n          COMPOSE_ID: ${{ env.DOKPLOY_COMPOSE_ID }}\n          EXPECTED_STACK: ${{ env.EXPECTED_DOKPLOY_STACK }}\n          EXPECTED_APP_HOST: ${{ env.EXPECTED_APP_HOST }}\n          FEATURE_CANDIDATE_VERIFIED: ${{ inputs.feature_candidate_verified }}\n        run: |\n          set -euo pipefail\n          umask 077\n          response=\"$(mktemp)\"\n          trap 'rm -f \"$response\"' EXIT\n          http_status=\"$(scripts/cluster/dokploy-curl.sh -sS --connect-timeout 5 --max-time 20 \\\n            --retry 2 --retry-delay 2 --retry-max-time 30 \\\n            --noproxy \"${DOKPLOY_CURL_RESOLVE%%:*}\" \\\n            --resolve \"$DOKPLOY_CURL_RESOLVE\" -G -o \"$response\" -w '%{http_code}' \\\n            \"${DOKPLOY_URL%/}/api/compose.one\" \\\n            --data-urlencode \"composeId=$COMPOSE_ID\")\" || http_status=000\n\n          if [ \"$http_status\" = 200 ]; then\n            if ! jq -e --arg id \"$COMPOSE_ID\" \\\n                '.composeId == $id and .serverId == null' \"$response\" >/dev/null; then\n              echo \"::error::Dokploy compose.one did not return the configured local compose target\"\n              exit 1\n            fi\n            target_stack=\"$(jq -er '.appName | select(type==\"string\" and length>0)' \"$response\")\"\n            if [ \"$target_stack\" != \"$EXPECTED_STACK\" ]; then\n              echo \"::error::Dokploy compose target does not match the selected deployment stack\"\n              exit 1\n            fi\n            if [ \"$FEATURE_CANDIDATE_VERIFIED\" = true ]; then\n              if ! jq -e --arg id \"$COMPOSE_ID\" --arg host \"$EXPECTED_APP_HOST\" '\n                .composeId == \"wYb0LxLQrvj2FPI21i-Oj\" and\n                .appName == \"uvanoo-v1-4-dev-gniriv\" and\n                .environmentId == \"qT391QtcIqahNap5wPjif\" and\n                $host == \"dev.uvanoo.com\" and\n                (.domains | type == \"array\" and length == 1) and\n                (.domains[0] | .composeId == $id and .host == $host and\n                  .serviceName == \"web\" and .port == 3000 and\n                  .path == \"/\" and .https == true and .enabled == true)\n              ' \"$response\" >/dev/null; then\n                echo \"::error::Canonical candidate DEV target must route only dev.uvanoo.com to web:3000 over HTTPS\"\n                exit 1\n              fi\n            fi\n            existing_registry_id_json=\"$(jq -c '\n              if (has(\"registryId\") | not) or .registryId == null then null\n              elif (.registryId | type) == \"string\" and (.registryId | length) > 0 then\n                .registryId\n              else\n                error(\"invalid registryId\")\n              end\n            ' \"$response\")\" \\\n              || { echo \"::error::Dokploy compose target returned an invalid registry identity\"; exit 1; }\n            deploy_mode=api\n          elif [[ \"$http_status\" =~ ^(000|401|403|500|502|503|504)$ ]]; then\n            if [ \"$FEATURE_CANDIDATE_VERIFIED\" = true ]; then\n              echo \"::error::Verified candidates require the canonical Dokploy DEV target; direct fallback is forbidden\"\n              exit 1\n            fi\n            mapfile -t stacks < <(\n              docker service ls --format '{{.Name}} {{.Image}}' \\\n                | awk '$2 ~ /^ghcr\\.io\\/braedonsaunders\\/beaconhs(@|:)/ && $1 ~ /_web$/ {sub(/_web$/, \"\", $1); print $1}'\n            )\n            if [ \"${#stacks[@]}\" -ne 1 ]; then\n              echo \"::error::Direct deployment requires exactly one existing BeaconHS Swarm stack\"\n              exit 1\n            fi\n            target_stack=\"${stacks[0]}\"\n            for role in web worker scheduler storage-init; do\n              service=\"${target_stack}_${role}\"\n              image=\"$(docker service inspect \"$service\" \\\n                --format '{{.Spec.TaskTemplate.ContainerSpec.Image}}')\"\n              if [[ ! \"$image\" =~ ^ghcr\\.io/braedonsaunders/beaconhs(@|:) ]]; then\n                echo \"::error::Direct deployment target $service is not a BeaconHS service\"\n                exit 1\n              fi\n            done\n            existing_registry_id_json=null\n            deploy_mode=direct\n            echo \"::warning::Dokploy API returned HTTP $http_status; using the validated image-only Swarm rollout\"\n          else\n            echo \"::error::Dokploy compose.one returned unexpected HTTP $http_status\"\n            exit 1\n          fi\n\n          if [[ ! \"$target_stack\" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]]; then\n            echo \"::error::Deployment target returned an invalid Swarm stack name\"\n            exit 1\n          fi\n          {\n            printf 'DOKPLOY_TARGET_STACK=%s\\n' \"$target_stack\"\n            printf 'DOKPLOY_EXISTING_REGISTRY_ID_JSON=%s\\n' \"$existing_registry_id_json\"\n            printf 'DOKPLOY_DEPLOY_MODE=%s\\n' \"$deploy_mode\"\n          } >> \"$GITHUB_ENV\"\n\n          if [ \"$deploy_mode\" = api ]; then\n            previous_image=\"$(awk -F= '$1 == \"IMAGE\" {sub(/^[^=]*=/, \"\"); print; exit}' \"$response\")\"\n            previous_source_sha=\"$(awk -F= '$1 == \"APP_VERSION\" {sub(/^[^=]*=/, \"\"); print; exit}' \"$response\")\"\n          else\n            previous_image=\"$(docker service inspect \"${target_stack}_web\" --format '{{.Spec.TaskTemplate.ContainerSpec.Image}}')\"\n            previous_source_sha=\"$(docker service inspect \"${target_stack}_web\" --format '{{range .Spec.TaskTemplate.ContainerSpec.Env}}{{println .}}{{end}}' | awk -F= '$1 == \"APP_VERSION\" {print $2; exit}')\"\n          fi\n          {\n            echo \"Previous DEV source SHA: ${previous_source_sha:-not recorded}\"\n            echo \"Previous DEV image digest: ${previous_image#*@}\"\n          } >> \"$GITHUB_STEP_SUMMARY\"\n\n      # Prove this run's least-privilege package token can read the exact\n      # private image before touching anything. The token stays in a temporary\n      # Docker config and is never persisted over Dokploy's registry login.\n      - name: Pre-pull images onto the swarm manager\n        env:\n          GHCR_USER: ${{ github.actor }}\n          GHCR_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          if ! command -v docker >/dev/null 2>&1; then\n            echo \"::error::docker CLI not present on runner (socket mount expected)\"\n            exit 1\n          fi\n          IMAGE=\"${DEPLOY_IMAGE_NAME}@${IMAGE_DIGEST}\"\n          DOCKER_CONFIG=\"$(mktemp -d)\"\n          chmod 0700 \"$DOCKER_CONFIG\"\n          export DOCKER_CONFIG\n          trap 'docker logout ghcr.io >/dev/null 2>&1 || true; rm -rf \"$DOCKER_CONFIG\"' EXIT\n          echo \"$GHCR_TOKEN\" | docker login ghcr.io -u \"$GHCR_USER\" --password-stdin\n          docker pull \"$IMAGE\"\n          docker image inspect \"$IMAGE\" --format 'pulled {{.Id}}'\n          docker pull \"$COLLABORA_IMAGE\"\n          docker image inspect \"$COLLABORA_IMAGE\" --format 'pulled Collabora {{.Id}}'\n          docker pull \"$MIGRATION_NODE_IMAGE\"\n          docker image inspect \"$MIGRATION_NODE_IMAGE\" --format 'pulled migration runtime {{.Id}}'\n          docker pull \"$DEPLOY_UTILITY_IMAGE\"\n          docker image inspect \"$DEPLOY_UTILITY_IMAGE\" --format 'pulled deployment utility {{.Id}}'\n\n      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6\n        with: { node-version: 24.18.0 }\n      # Install Node first: the self-hosted runner's system Node is not a\n      # supported application runtime, and pnpm's installer invokes npm.\n      # package.json's packageManager field pins pnpm; passing a version here\n      # too errors with \"Multiple versions of pnpm specified\".\n      - uses: pnpm/action-setup@0ebf47130e4866e96fce0953f49152a61190b271 # v6.0.9\n      - run: pnpm install --frozen-lockfile\n\n      # The migration container deliberately uses the exact pnpm provisioned\n      # by the pinned setup action. Do not invoke Corepack in the container:\n      # that would fetch pnpm from the public registry after the deployment\n      # has reached its forward-only migration phase.\n      - name: Verify deterministic migration toolchain\n        run: |\n          set -euo pipefail\n          if [ \"$(pnpm --version)\" != '10.30.3' ]; then\n            echo '::error::The deployment runner did not provision pnpm 10.30.3'\n            exit 1\n          fi\n          if [ -z \"${PNPM_HOME:-}\" ]; then\n            echo '::error::pnpm/action-setup did not expose PNPM_HOME'\n            exit 1\n          fi\n          toolchain_root=\"$(cd \"$PNPM_HOME/../..\" && pwd -P)\"\n          test -x \"$toolchain_root/node_modules/.bin/pnpm\"\n          echo \"MIGRATION_PNPM_TOOLCHAIN_ROOT=$toolchain_root\" >> \"$GITHUB_ENV\"\n          docker run --rm --pull=never \\\n            -v \"$toolchain_root:/pnpm-toolchain:ro\" \\\n            -v \"$GITHUB_WORKSPACE:/workspace:ro\" \\\n            -w /workspace \\\n            -e PATH=/pnpm-toolchain/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \\\n            \"$MIGRATION_NODE_IMAGE\" \\\n            pnpm --version | grep -Fx '10.30.3'\n          docker run --rm --pull=never \\\n            -v \"$toolchain_root:/pnpm-toolchain:ro\" \\\n            -v \"$GITHUB_WORKSPACE:/workspace:ro\" \\\n            -w /workspace \\\n            -e PATH=/pnpm-toolchain/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \\\n            \"$MIGRATION_NODE_IMAGE\" \\\n            pnpm --filter @beaconhs/db exec tsx --version\n\n      # Forward-only schema migrations run before the redeploy. The unpooled\n      # migrator login can SET ROLE to the NOLOGIN owner; neither credential\n      # reaches the long-running deployment containers.\n      - name: Require complete selected database credential bundle\n        env:\n          FEATURE_CANDIDATE_VERIFIED: ${{ inputs.feature_candidate_verified }}\n          DEV_MIGRATION_DATABASE_URL: ${{ secrets.DEV_MIGRATION_DATABASE_URL }}\n          DEV_DATABASE_URL: ${{ secrets.DEV_DATABASE_URL }}\n          DEV_SUPERADMIN_DATABASE_URL: ${{ secrets.DEV_SUPERADMIN_DATABASE_URL }}\n          MAIN_MIGRATION_DATABASE_URL: ${{ secrets.MAIN_MIGRATION_DATABASE_URL }}\n          MAIN_DATABASE_URL: ${{ secrets.MAIN_DATABASE_URL }}\n          MAIN_SUPERADMIN_DATABASE_URL: ${{ secrets.MAIN_SUPERADMIN_DATABASE_URL }}\n        run: |\n          set -euo pipefail\n          if [ \"$FEATURE_CANDIDATE_VERIFIED\" = true ]; then\n            selected_bundle=(\n              DEV_MIGRATION_DATABASE_URL\n              DEV_DATABASE_URL\n              DEV_SUPERADMIN_DATABASE_URL\n            )\n          else\n            selected_bundle=(\n              MAIN_MIGRATION_DATABASE_URL\n              MAIN_DATABASE_URL\n              MAIN_SUPERADMIN_DATABASE_URL\n            )\n          fi\n\n          for credential_name in \"${selected_bundle[@]}\"; do\n            if [ -z \"${!credential_name}\" ]; then\n              echo \"::error::Selected database credential bundle is incomplete\"\n              exit 1\n            fi\n          done\n\n      - name: Select and validate storage credential bundle\n        env:\n          FEATURE_CANDIDATE_VERIFIED: ${{ inputs.feature_candidate_verified }}\n          DEV_R2_ENDPOINT: ${{ secrets.DEV_R2_ENDPOINT }}\n          DEV_R2_ACCESS_KEY_ID: ${{ secrets.DEV_R2_ACCESS_KEY_ID }}\n          DEV_R2_SECRET_ACCESS_KEY: ${{ secrets.DEV_R2_SECRET_ACCESS_KEY }}\n          DEV_R2_BUCKET: ${{ secrets.DEV_R2_BUCKET }}\n          DEV_R2_PRIVATE_BUCKET_CONFIRMED: ${{ secrets.DEV_R2_PRIVATE_BUCKET_CONFIRMED }}\n          MAIN_R2_ENDPOINT: ${{ secrets.R2_ENDPOINT }}\n          MAIN_R2_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}\n          MAIN_R2_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}\n          MAIN_R2_BUCKET: ${{ secrets.R2_BUCKET }}\n          MAIN_R2_PRIVATE_BUCKET_CONFIRMED: ${{ secrets.R2_PRIVATE_BUCKET_CONFIRMED }}\n        run: |\n          set -euo pipefail\n          case \"$FEATURE_CANDIDATE_VERIFIED\" in\n            true) storage_prefix=DEV_ ;;\n            false) storage_prefix=MAIN_ ;;\n            *) echo '::error::Unknown storage deployment context'; exit 1 ;;\n          esac\n          storage_names=(R2_ENDPOINT R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY R2_BUCKET R2_PRIVATE_BUCKET_CONFIRMED)\n          for name in \"${storage_names[@]}\"; do\n            source_name=\"${storage_prefix}${name}\"\n            value=\"${!source_name}\"\n            if [[ \"$value\" == *$'\\n'* || \"$value\" == *$'\\r'* ]]; then\n              echo '::error::Selected storage value contains a newline'\n              exit 1\n            fi\n            if [ \"$FEATURE_CANDIDATE_VERIFIED\" = true ] && [ -z \"$value\" ]; then\n              echo '::error::Selected DEV storage bundle is incomplete'\n              exit 1\n            fi\n            export \"$name=$value\"\n          done\n          if [ \"$FEATURE_CANDIDATE_VERIFIED\" = true ]; then\n            node -e '\n              try {\n                const endpoint = new URL(process.env.R2_ENDPOINT);\n                if (endpoint.protocol !== \"http:\" || endpoint.hostname !== \"uvanoo-dev-minio\" ||\n                    endpoint.port !== \"9000\" || endpoint.username || endpoint.password ||\n                    endpoint.pathname !== \"/\" || endpoint.search || endpoint.hash ||\n                    process.env.R2_BUCKET !== \"uvanoo-dev\" ||\n                    process.env.R2_PRIVATE_BUCKET_CONFIRMED !== \"true\" ||\n                    !process.env.R2_ACCESS_KEY_ID.trim() || !process.env.R2_SECRET_ACCESS_KEY.trim()) {\n                  throw new Error(\"topology\");\n                }\n              } catch {\n                console.error(\"::error::DEV storage bundle does not match isolated private storage\");\n                process.exit(1);\n              }\n            '\n          fi\n          for name in \"${storage_names[@]}\"; do\n            printf '%s=%s\\n' \"$name\" \"${!name}\" >> \"$GITHUB_ENV\"\n          done\n          echo 'Selected storage bundle validated'\n\n      - name: Validate migration database URLs\n        env:\n          MIGRATION_DATABASE_URL: ${{ env.MIGRATION_DATABASE_URL }}\n          DATABASE_URL: ${{ env.DATABASE_URL }}\n          SUPERADMIN_DATABASE_URL: ${{ env.SUPERADMIN_DATABASE_URL }}\n          EXPECTED_MIGRATION_HOST: ${{ env.EXPECTED_MIGRATION_HOST }}\n          EXPECTED_DATABASE_NAME: ${{ env.EXPECTED_DATABASE_NAME }}\n        run: |\n          node -e '\n            const urls = [\n              [\"MIGRATION_DATABASE_URL\", \"beaconhs_migrator\"],\n              [\"DATABASE_URL\", \"beaconhs_app\"],\n              [\"SUPERADMIN_DATABASE_URL\", \"beaconhs_super\"],\n            ];\n            for (const [name, role] of urls) {\n              const u = new URL(process.env[name]);\n              if (\n                u.protocol !== \"postgresql:\" ||\n                u.hostname !== process.env.EXPECTED_MIGRATION_HOST ||\n                (u.port && u.port !== \"5432\") ||\n                u.pathname !== \"/\" + process.env.EXPECTED_DATABASE_NAME ||\n                decodeURIComponent(u.username) !== role ||\n                !u.password\n              ) {\n                console.error(`::error::${name} does not match the selected deployment topology`);\n                process.exit(1);\n              }\n            }\n            console.log(\"Migration database URLs match the selected deployment topology\");\n          '\n\n      - name: Validate selected Redis URL\n        env:\n          FEATURE_CANDIDATE_VERIFIED: ${{ inputs.feature_candidate_verified }}\n          REDIS_URL: ${{ env.REDIS_URL }}\n        run: |\n          node -e '\n            let url;\n            try {\n              url = new URL(process.env.REDIS_URL);\n            } catch {\n              console.error(\"::error::Selected Redis credential is missing or invalid\");\n              process.exit(1);\n            }\n            const candidate = process.env.FEATURE_CANDIDATE_VERIFIED === \"true\";\n            const expectedHost = candidate ? \"uvanoo-dev-redis\" : \"beaconhs-redis\";\n            if (url.protocol !== \"redis:\" || url.hostname !== expectedHost || (url.port && url.port !== \"6379\")) {\n              console.error(\"::error::Selected Redis credential does not match the deployment topology\");\n              process.exit(1);\n            }\n            if (candidate && !url.password) {\n              console.error(\"::error::Selected candidate Redis credential requires authentication\");\n              process.exit(1);\n            }\n            console.log(\"Selected Redis credential matches the deployment topology\");\n          '\n\n      - name: Persist apply and verify DEV writer fence\n        if: inputs.feature_candidate_verified\n        id: writer-fence\n        env:\n          FEATURE_CANDIDATE_VERIFIED: ${{ inputs.feature_candidate_verified }}\n          DOKPLOY_URL: ${{ secrets.DOKPLOY_URL }}\n          DOKPLOY_TOKEN: ${{ secrets.DOKPLOY_TOKEN }}\n        run: node .deployment-governance/scripts/cluster/dev-writer-fence.mjs fence\n\n      - name: Preflight all migration database roles\n        env:\n          EXPECTED_DATABASE_NAME: ${{ env.EXPECTED_DATABASE_NAME }}\n          NODE_ENV: production\n          MIGRATION_DATABASE_URL: ${{ env.MIGRATION_DATABASE_URL }}\n          DATABASE_URL: ${{ env.DATABASE_URL }}\n          SUPERADMIN_DATABASE_URL: ${{ env.SUPERADMIN_DATABASE_URL }}\n        run: |\n          evidence_mount=()\n          if [ \"$FEATURE_CANDIDATE_VERIFIED\" = true ]; then\n            evidence_mount=(-v \"/opt/uvanoo-dev/release-evidence/$DEPLOY_SOURCE_SHA:/release-evidence:ro\")\n          fi\n          docker run --rm --pull=never --network \"$MIGRATION_DOCKER_NETWORK\" \\\n            \"${evidence_mount[@]}\" \\\n            -v \"$GITHUB_WORKSPACE:/workspace\" \\\n            -v \"$MIGRATION_PNPM_TOOLCHAIN_ROOT:/pnpm-toolchain:ro\" \\\n            -w /workspace \\\n            -e PATH=/pnpm-toolchain/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \\\n            -e NODE_ENV=\"$NODE_ENV\" \\\n            -e EXPECTED_DATABASE_NAME \\\n            -e MIGRATION_DATABASE_URL=\"$MIGRATION_DATABASE_URL\" \\\n            -e DATABASE_URL=\"$DATABASE_URL\" \\\n            -e SUPERADMIN_DATABASE_URL=\"$SUPERADMIN_DATABASE_URL\" \\\n            \"$MIGRATION_NODE_IMAGE\" \\\n            pnpm --filter @beaconhs/db exec tsx -e '\n              import postgres from \"postgres\";\n              (async () => {\n                const connections = [\n                  [\"MIGRATION_DATABASE_URL\", \"beaconhs_migrator\"],\n                  [\"DATABASE_URL\", \"beaconhs_app\"],\n                  [\"SUPERADMIN_DATABASE_URL\", \"beaconhs_super\"],\n                ];\n                for (const [name, expectedRole] of connections) {\n                  for (let attempt = 1; attempt <= 3; attempt++) {\n                    const client = postgres(process.env[name], { connect_timeout: 5, max: 1 });\n                    try {\n                      const [identity] = await client`SELECT current_user, current_database()`;\n                      if (identity.current_user !== expectedRole || identity.current_database !== process.env.EXPECTED_DATABASE_NAME) {\n                        throw new Error(`${name} identity mismatch`);\n                      }\n                      console.log(`${name} identity verified`);\n                      break;\n                    } catch (error) {\n                      if (error && typeof error === \"object\" && error.code === \"EAI_AGAIN\" && attempt < 3) {\n                        console.log(`${name} DNS not ready; retrying (${attempt}/3)`);\n                        await new Promise((resolve) => setTimeout(resolve, 1000));\n                        continue;\n                      }\n                      throw error;\n                    } finally {\n                      await client.end({ timeout: 1 }).catch(() => undefined);\n                    }\n                  }\n                }\n              })().catch((error) => {\n                console.error(\"Database role preflight failed; connection diagnostics withheld\");\n                process.exit(1);\n              });\n            '\n\n      - name: Preflight candidate runtime topology\n        if: inputs.feature_candidate_verified\n        env:\n          REDIS_URL: ${{ env.REDIS_URL }}\n          EXPECTED_MIGRATION_HOST: ${{ env.EXPECTED_MIGRATION_HOST }}\n        run: |\n          set -euo pipefail\n          if ! docker network inspect \"$RUNTIME_DOCKER_NETWORK\" | jq -e '\n            length == 1 and .[0].Name == \"uvanoo-dev-runtime\" and\n            .[0].Driver == \"overlay\" and .[0].Scope == \"swarm\" and\n            .[0].Attachable == true and .[0].Internal == true\n          ' >/dev/null; then\n            echo '::error::Candidate runtime preflight failed [NETWORK_ATTRIBUTES]: topology mismatch'\n            exit 1\n          fi\n          docker run --rm --pull=never --network \"$RUNTIME_DOCKER_NETWORK\" \\\n            -e REDIS_URL \\\n            -e EXPECTED_MIGRATION_HOST \\\n            --entrypoint node \\\n            \"$MIGRATION_NODE_IMAGE\" -e '\n              const dns = require(\"node:dns\").promises;\n              const net = require(\"node:net\");\n              const networkCodes = new Set([\"EAI_AGAIN\", \"ECONNREFUSED\", \"EHOSTUNREACH\", \"ENETUNREACH\", \"ENOTFOUND\", \"ETIMEDOUT\"]);\n              const safeCode = (error, fallback) => {\n                const code = error && typeof error.code === \"string\" ? error.code : \"\";\n                return /^[A-Z0-9_]+$/.test(code) ? code : fallback;\n              };\n              const fail = (stage, error, fallback) => {\n                console.error(`::error::Candidate runtime preflight failed [${stage}]: ${safeCode(error, fallback)}`);\n                process.exit(1);\n              };\n              (async () => {\n                let url;\n                try {\n                  url = new URL(process.env.REDIS_URL);\n                } catch (error) {\n                  fail(\"REDIS_URL_TOPOLOGY\", error, \"INVALID_URL\");\n                  return;\n                }\n                if (url.protocol !== \"redis:\") {\n                  fail(\"REDIS_URL_TOPOLOGY\", null, \"UNEXPECTED_PROTOCOL\");\n                  return;\n                }\n                if (url.hostname !== \"uvanoo-dev-redis\") {\n                  fail(\"REDIS_URL_TOPOLOGY\", null, \"UNEXPECTED_HOSTNAME\");\n                  return;\n                }\n                if (url.port && url.port !== \"6379\") {\n                  fail(\"REDIS_URL_TOPOLOGY\", null, \"UNEXPECTED_PORT\");\n                  return;\n                }\n                if (!url.password) {\n                  fail(\"REDIS_URL_TOPOLOGY\", null, \"MISSING_PASSWORD\");\n                  return;\n                }\n                try {\n                  await new Promise((resolve, reject) => {\n                    const socket = net.createConnection({ host: process.env.EXPECTED_MIGRATION_HOST, port: 5432 });\n                    socket.setTimeout(5000);\n                    socket.once(\"connect\", () => { socket.destroy(); resolve(); });\n                    socket.once(\"error\", reject);\n                    socket.once(\"timeout\", () => { socket.destroy(); reject(Object.assign(new Error(\"PostgreSQL runtime connection timed out\"), { code: \"ETIMEDOUT\" })); });\n                  });\n                } catch (error) {\n                  fail(\"POSTGRES_DNS_OR_TCP\", error, \"CONNECTION_FAILED\");\n                  return;\n                }\n                try {\n                  await dns.lookup(url.hostname);\n                } catch (error) {\n                  fail(\"REDIS_DNS_OR_TCP\", error, \"DNS_FAILED\");\n                  return;\n                }\n                let socket;\n                try {\n                  socket = net.createConnection({ host: url.hostname, port: Number(url.port || 6379) });\n                  socket.setTimeout(5000);\n                  await new Promise((resolve, reject) => {\n                    socket.once(\"connect\", resolve);\n                    socket.once(\"error\", reject);\n                    socket.once(\"timeout\", () => reject(Object.assign(new Error(\"Redis connection timed out\"), { code: \"ETIMEDOUT\" })));\n                  });\n                } catch (error) {\n                  fail(\"REDIS_DNS_OR_TCP\", error, \"CONNECTION_FAILED\");\n                  return;\n                }\n                const encode = (parts) => `*${parts.length}\\r\\n${parts.map((part) => `$${Buffer.byteLength(part)}\\r\\n${part}\\r\\n`).join(\"\")}`;\n                const command = (parts) => new Promise((resolve, reject) => {\n                  let response = \"\";\n                  const timeout = setTimeout(() => reject(Object.assign(new Error(\"Redis command timed out\"), { code: \"ETIMEDOUT\" })), 5000);\n                  const onData = (chunk) => {\n                    response += chunk;\n                    if (response.includes(\"\\r\\n\")) {\n                      clearTimeout(timeout);\n                      socket.off(\"data\", onData);\n                      resolve(response);\n                    }\n                  };\n                  socket.on(\"data\", onData);\n                  socket.once(\"error\", reject);\n                  socket.write(encode(parts));\n                });\n                try {\n                  const password = decodeURIComponent(url.password);\n                  const auth = await command(url.username ? [\"AUTH\", decodeURIComponent(url.username), password] : [\"AUTH\", password]);\n                  if (!auth.startsWith(\"+OK\")) {\n                    fail(\"REDIS_AUTH_OR_PING\", null, \"AUTH_FAILED\");\n                    return;\n                  }\n                  const pong = await command([\"PING\"]);\n                  if (!pong.startsWith(\"+PONG\")) {\n                    fail(\"REDIS_AUTH_OR_PING\", null, \"PING_NOT_PONG\");\n                    return;\n                  }\n                  console.log(\"Candidate runtime PostgreSQL reachable; authenticated Redis PONG\");\n                } catch (error) {\n                  fail(networkCodes.has(error && error.code) ? \"REDIS_DNS_OR_TCP\" : \"REDIS_AUTH_OR_PING\", error, \"CONNECTION_FAILED\");\n                } finally {\n                  socket.destroy();\n                }\n              })().catch((error) => {\n                console.error(`::error::Candidate runtime preflight failed [RUNTIME_DEPENDENCY]: ${safeCode(error, \"UNEXPECTED_FAILURE\")}`);\n                process.exit(1);\n              });\n            '\n\n      - name: Validate DEV release evidence input\n        if: inputs.feature_candidate_verified\n        env:\n          EVIDENCE_SHA256: ${{ inputs.release_evidence_sha256 }}\n        run: |\n          set -euo pipefail\n          [[ \"$EVIDENCE_SHA256\" =~ ^[0-9a-f]{64}$ ]]\n          evidence_dir=\"/opt/uvanoo-dev/release-evidence/$DEPLOY_SOURCE_SHA\"\n          test -d \"$evidence_dir\"\n          test ! -L \"$evidence_dir\"\n          test \"$(realpath \"$evidence_dir\")\" = \"$evidence_dir\"\n          test -f \"$evidence_dir/manifest.json\"\n          test \"$(sha256sum \"$evidence_dir/manifest.json\" | cut -d ' ' -f1)\" = \"$EVIDENCE_SHA256\"\n\n      - name: Run database migrations\n        id: migrations\n        env:\n          FEATURE_CANDIDATE_VERIFIED: ${{ inputs.feature_candidate_verified }}\n          DOKPLOY_URL: ${{ secrets.DOKPLOY_URL }}\n          DOKPLOY_TOKEN: ${{ secrets.DOKPLOY_TOKEN }}\n          NODE_ENV: production\n          MIGRATION_DATABASE_URL: ${{ env.MIGRATION_DATABASE_URL }}\n          DATABASE_URL: ${{ env.DATABASE_URL }}\n          SUPERADMIN_DATABASE_URL: ${{ env.SUPERADMIN_DATABASE_URL }}\n          DATABASE_OWNER_ROLE: beaconhs_owner\n          DEV_RELEASE_EVIDENCE_SHA256: ${{ inputs.release_evidence_sha256 }}\n          DEV_BACKUP_DATABASE_URL: ${{ secrets.DEV_BACKUP_DATABASE_URL }}\n        run: |\n          set -euo pipefail\n          if [ \"$FEATURE_CANDIDATE_VERIFIED\" = true ]; then\n            node .deployment-governance/scripts/cluster/dev-writer-fence.mjs verify-zero\n          fi\n          # DEV requires strict source-prefix, schema/security and verified backup evidence.\n          # Ordinary main routing remains unchanged.\n          migration_entrypoint=src/migrate.ts\n          if [ \"$FEATURE_CANDIDATE_VERIFIED\" = true ]; then\n            migration_entrypoint=src/migrate-dev.ts\n          fi\n          docker run --rm --pull=never --network \"$MIGRATION_DOCKER_NETWORK\" \\\n            -v \"$GITHUB_WORKSPACE:/workspace\" \\\n            -v \"$MIGRATION_PNPM_TOOLCHAIN_ROOT:/pnpm-toolchain:ro\" \\\n            -w /workspace \\\n            -e PATH=/pnpm-toolchain/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \\\n            -e NODE_ENV=\"$NODE_ENV\" \\\n            -e MIGRATION_DATABASE_URL=\"$MIGRATION_DATABASE_URL\" \\\n            -e DATABASE_URL=\"$DATABASE_URL\" \\\n            -e SUPERADMIN_DATABASE_URL=\"$SUPERADMIN_DATABASE_URL\" \\\n            -e DATABASE_OWNER_ROLE=\"$DATABASE_OWNER_ROLE\" \\\n            -e FEATURE_CANDIDATE_VERIFIED=\"$FEATURE_CANDIDATE_VERIFIED\" \\\n            -e DEV_RELEASE_EVIDENCE_PATH=/release-evidence/manifest.json \\\n            -e DEV_RELEASE_EVIDENCE_SHA256 \\\n            -e DEV_BACKUP_DATABASE_URL \\\n            -e DEPLOY_SOURCE_SHA \\\n            -e IMAGE_DIGEST \\\n            \"$MIGRATION_NODE_IMAGE\" \\\n            pnpm --filter @beaconhs/db exec tsx \"$migration_entrypoint\"\n\n      # coolwsd caches browser assets at startup, so a changed branding file\n      # needs a Collabora restart; an unchanged file needs nothing.\n      - name: Install Collabora branding on the swarm manager\n        run: |\n          set -euo pipefail\n          before=\"$(docker run --rm --pull=never -v /etc/dokploy/beaconhs:/target \"$DEPLOY_UTILITY_IMAGE\" \\\n            sh -c 'sha256sum /target/collabora-branding.js 2>/dev/null | cut -d\" \" -f1' || true)\"\n          docker run --rm --pull=never -i -v /etc/dokploy/beaconhs:/target \"$DEPLOY_UTILITY_IMAGE\" \\\n            sh -c 'cat > /target/collabora-branding.js && chmod 0644 /target/collabora-branding.js' \\\n            < deploy/collabora-branding.js\n          after=\"$(sha256sum deploy/collabora-branding.js | cut -d' ' -f1)\"\n          echo \"branding installed ($(wc -c < deploy/collabora-branding.js) bytes)\"\n          if [ \"$before\" != \"$after\" ]; then\n            service=\"${DOKPLOY_TARGET_STACK}_collabora\"\n            if docker service inspect \"$service\" >/dev/null 2>&1; then\n              echo \"branding changed — restarting the current Collabora service\"\n              docker service update --force \"$service\" >/dev/null\n            else\n              echo \"No existing Collabora service found; the new deployment will load the branding\"\n            fi\n          else\n            echo \"branding unchanged — no restart needed\"\n          fi\n\n      - name: Update the Dokploy compose environment\n        if: env.DOKPLOY_DEPLOY_MODE == 'api'\n        env:\n          FEATURE_CANDIDATE_VERIFIED: ${{ inputs.feature_candidate_verified }}\n          DOKPLOY_URL: ${{ secrets.DOKPLOY_URL }}\n          DOKPLOY_TOKEN: ${{ secrets.DOKPLOY_TOKEN }}\n          COMPOSE_ID: ${{ env.DOKPLOY_COMPOSE_ID }}\n          DATABASE_URL: ${{ env.DATABASE_URL }}\n          SUPERADMIN_DATABASE_URL: ${{ env.SUPERADMIN_DATABASE_URL }}\n          REDIS_URL: ${{ env.REDIS_URL }}\n          APP_URL: ${{ secrets.DEV_APP_URL }}\n          BETTER_AUTH_SECRET: ${{ secrets.DEV_BETTER_AUTH_SECRET }}\n          ATTACHMENT_CAPABILITY_SECRET: ${{ secrets.DEV_ATTACHMENT_CAPABILITY_SECRET }}\n          R2_ENDPOINT: ${{ env.R2_ENDPOINT }}\n          R2_ACCESS_KEY_ID: ${{ env.R2_ACCESS_KEY_ID }}\n          R2_SECRET_ACCESS_KEY: ${{ env.R2_SECRET_ACCESS_KEY }}\n          R2_BUCKET: ${{ env.R2_BUCKET }}\n          R2_PRIVATE_BUCKET_CONFIRMED: ${{ env.R2_PRIVATE_BUCKET_CONFIRMED }}\n          VAPID_PUBLIC_KEY: ${{ secrets.VAPID_PUBLIC_KEY }}\n          VAPID_PRIVATE_KEY: ${{ secrets.VAPID_PRIVATE_KEY }}\n          VAPID_SUBJECT: ${{ secrets.VAPID_SUBJECT }}\n          SENTRY_DSN: ${{ secrets.SENTRY_DSN }}\n        run: |\n          set -euo pipefail\n          umask 077\n          update_response=\"$(mktemp)\"\n          compose_state=\"$(mktemp)\"\n          env_block_file=\"$(mktemp)\"\n          trap 'rm -f \"$update_response\" \"$compose_state\" \"$env_block_file\"' EXIT\n          IMAGE=\"${DEPLOY_IMAGE_NAME}@${IMAGE_DIGEST}\"\n          COMPOSE_FILE=\"$(cat .deployment-governance/deploy/dokploy-dev.compose.yaml)\"\n          # Collabora is served same-origin on the app domain (Traefik path\n          # routes), so both editor and WOPI-callback bases are APP_URL; the\n          # server_name is the bare host for Collabora's generated URLs.\n          APP_HOST=\"$(printf '%s' \"$APP_URL\" | sed -E 's~^https?://~~; s~/+$~~' | tr '[:upper:]' '[:lower:]')\"\n          {\n            printf 'IMAGE=%s\\n' \"$IMAGE\"\n            printf 'APP_VERSION=%s\\n' \"$DEPLOY_SOURCE_SHA\"\n            # Install candidate service specs while the persisted fence remains\n            # closed. Only the verified restore step may start new writers.\n            if [ \"$FEATURE_CANDIDATE_VERIFIED\" = true ]; then\n              printf 'WRITER_REPLICAS=0\\n'\n            else\n              printf 'WRITER_REPLICAS=1\\n'\n            fi\n            printf 'COLLABORA_IMAGE=%s\\n' \"$COLLABORA_IMAGE\"\n            printf 'COLLABORA_URL=%s\\n' \"$APP_URL\"\n            printf 'COLLABORA_WOPI_URL=%s\\n' \"$APP_URL\"\n            printf 'COLLABORA_SERVER_NAME=%s\\n' \"$APP_HOST\"\n            printf 'DATABASE_URL=%s\\n' \"$DATABASE_URL\"\n            printf 'SUPERADMIN_DATABASE_URL=%s\\n' \"$SUPERADMIN_DATABASE_URL\"\n            printf 'REDIS_URL=%s\\n' \"$REDIS_URL\"\n            printf 'RUNTIME_DB_NETWORK=%s\\n' \"$RUNTIME_DOCKER_NETWORK\"\n            printf 'APP_URL=%s\\n' \"$APP_URL\"\n            printf 'BETTER_AUTH_SECRET=%s\\n' \"$BETTER_AUTH_SECRET\"\n            printf 'ATTACHMENT_CAPABILITY_SECRET=%s\\n' \"$ATTACHMENT_CAPABILITY_SECRET\"\n            printf 'R2_ENDPOINT=%s\\n' \"$R2_ENDPOINT\"\n            printf 'R2_ACCESS_KEY_ID=%s\\n' \"$R2_ACCESS_KEY_ID\"\n            printf 'R2_SECRET_ACCESS_KEY=%s\\n' \"$R2_SECRET_ACCESS_KEY\"\n            printf 'R2_BUCKET=%s\\n' \"$R2_BUCKET\"\n            printf 'R2_PRIVATE_BUCKET_CONFIRMED=%s\\n' \"$R2_PRIVATE_BUCKET_CONFIRMED\"\n            printf 'VAPID_PUBLIC_KEY=%s\\n' \"$VAPID_PUBLIC_KEY\"\n            printf 'VAPID_PRIVATE_KEY=%s\\n' \"$VAPID_PRIVATE_KEY\"\n            printf 'VAPID_SUBJECT=%s\\n' \"$VAPID_SUBJECT\"\n            printf 'SENTRY_DSN=%s\\n' \"$SENTRY_DSN\"\n          } > \"$env_block_file\"\n          jq -n --arg id \"$COMPOSE_ID\" --arg cf \"$COMPOSE_FILE\" \\\n            --argjson registry \"$DOKPLOY_EXISTING_REGISTRY_ID_JSON\" \\\n            --rawfile env \"$env_block_file\" \\\n            '{composeId:$id, sourceType:\"raw\", composeType:\"stack\",\n              composeFile:$cf, env:$env, command:\"\", autoDeploy:false,\n              randomize:false, isolatedDeployment:false,\n              isolatedDeploymentsVolume:false, suffix:\"\",\n              composePath:\"./docker-compose.yml\", registryId:$registry}' \\\n            | scripts/cluster/dokploy-curl.sh -sS --fail --connect-timeout 5 --max-time 30 \\\n                --noproxy \"${DOKPLOY_CURL_RESOLVE%%:*}\" \\\n                --resolve \"$DOKPLOY_CURL_RESOLVE\" -o \"$update_response\" \\\n                -X POST \"${DOKPLOY_URL%/}/api/compose.update\" \\\n                -H \"content-type: application/json\" --data @-\n          # Re-read and prove the persisted compose matches what we sent — a\n          # 2xx acknowledgement alone has been observed to be ambiguous.\n          scripts/cluster/dokploy-curl.sh -sS --fail --connect-timeout 5 --max-time 20 \\\n            --retry 2 --retry-delay 2 --retry-max-time 30 \\\n            --noproxy \"${DOKPLOY_CURL_RESOLVE%%:*}\" --resolve \"$DOKPLOY_CURL_RESOLVE\" \\\n            -G -o \"$compose_state\" \"${DOKPLOY_URL%/}/api/compose.one\" \\\n            --data-urlencode \"composeId=$COMPOSE_ID\"\n          if ! jq -e --arg cid \"$COMPOSE_ID\" --arg cf \"$COMPOSE_FILE\" \\\n              --rawfile env \"$env_block_file\" '\n                .composeId==$cid and .serverId==null\n                  and .composeFile==$cf and .env==$env\n                  and .composeType==\"stack\" and .sourceType==\"raw\"\n                  and .autoDeploy==false' \"$compose_state\" >/dev/null; then\n            echo \"::error::Dokploy compose/environment postcondition failed after the update\"\n            exit 1\n          fi\n          echo \"Updated Dokploy compose environment for $IMAGE\"\n\n      - name: Deploy the compose on Dokploy\n        if: env.DOKPLOY_DEPLOY_MODE == 'api'\n        env:\n          DOKPLOY_URL: ${{ secrets.DOKPLOY_URL }}\n          DOKPLOY_TOKEN: ${{ secrets.DOKPLOY_TOKEN }}\n          COMPOSE_ID: ${{ env.DOKPLOY_COMPOSE_ID }}\n        run: |\n          set -euo pipefail\n          jq -n --arg id \"$COMPOSE_ID\" '{composeId:$id}' \\\n            | scripts/cluster/dokploy-curl.sh -sS --fail --connect-timeout 5 --max-time 60 \\\n                --noproxy \"${DOKPLOY_CURL_RESOLVE%%:*}\" \\\n                --resolve \"$DOKPLOY_CURL_RESOLVE\" \\\n                -X POST \"${DOKPLOY_URL%/}/api/compose.deploy\" \\\n                -H \"content-type: application/json\" --data @- >/dev/null\n          echo \"Dokploy compose deployment requested\"\n\n      - name: Restore verified DEV candidate writers\n        if: inputs.feature_candidate_verified\n        id: writer-restore\n        env:\n          FEATURE_CANDIDATE_VERIFIED: ${{ inputs.feature_candidate_verified }}\n          DOKPLOY_URL: ${{ secrets.DOKPLOY_URL }}\n          DOKPLOY_TOKEN: ${{ secrets.DOKPLOY_TOKEN }}\n        run: node .deployment-governance/scripts/cluster/dev-writer-fence.mjs restore\n\n      - name: Report DEV writer recovery state\n        if: ${{ always() && inputs.feature_candidate_verified && (failure() || cancelled()) }}\n        env:\n          FENCE_OUTCOME: ${{ steps.writer-fence.outcome }}\n          MIGRATION_OUTCOME: ${{ steps.migrations.outcome }}\n          RESTORE_OUTCOME: ${{ steps.writer-restore.outcome }}\n        run: |\n          {\n            echo 'DEV deployment failed or was cancelled; no automatic writer recovery.'\n            echo \"Fence: $FENCE_OUTCOME; migration: $MIGRATION_OUTCOME; restore: $RESTORE_OUTCOME.\"\n            echo 'If fencing began, assume writers remain fenced or state is uncertain until inspected.'\n            echo 'After any migration failure, require explicit database recovery review before restoring writers.'\n          } >> \"$GITHUB_STEP_SUMMARY\"\n\n      - name: Roll the immutable image directly on Swarm\n        if: env.DOKPLOY_DEPLOY_MODE == 'direct'\n        run: |\n          set -euo pipefail\n          image=\"${DEPLOY_IMAGE_NAME}@${IMAGE_DIGEST}\"\n          for role in web worker scheduler; do\n            service=\"${DOKPLOY_TARGET_STACK}_${role}\"\n            docker service update --detach=true --with-registry-auth \\\n              --image \"$image\" --env-rm APP_VERSION \\\n              --env-add \"APP_VERSION=$DEPLOY_SOURCE_SHA\" \"$service\"\n          done\n          docker service update --detach=true --with-registry-auth \\\n            --image \"$image\" \"${DOKPLOY_TARGET_STACK}_storage-init\"\n          echo \"Requested direct immutable-image rollout for $DOKPLOY_TARGET_STACK\"\n\n      - name: Wait for external readiness\n        env:\n          APP_URL: ${{ secrets.DEV_APP_URL }}\n          FEATURE_CANDIDATE_VERIFIED: ${{ inputs.feature_candidate_verified }}\n        run: |\n          set -euo pipefail\n          if [ \"$FEATURE_CANDIDATE_VERIFIED\" = true ]; then\n            node .deployment-governance/scripts/cluster/dev-readiness.mjs\n            exit 0\n          fi\n          ready_url=\"${APP_URL%/}/api/health/ready\"\n          login_url=\"${APP_URL%/}/login\"\n          deadline=$((SECONDS + 600))\n          last_login_status=\"not checked\"\n          while [ \"$SECONDS\" -lt \"$deadline\" ]; do\n            body=\"$(curl -fsS --connect-timeout 5 --max-time 15 \"$ready_url\" 2>/dev/null || true)\"\n            if [ -n \"$body\" ] \\\n              && jq -e --arg sha \"$DEPLOY_SOURCE_SHA\" \\\n                  '.status==\"ready\" and .version==$sha' <<< \"$body\" >/dev/null 2>&1; then\n              last_login_status=\"$(curl -sS -o /dev/null -w '%{http_code}' \\\n                --connect-timeout 5 --max-time 15 \"$login_url\" || true)\"\n              if [ \"$last_login_status\" = 200 ]; then\n                echo \"Deployment is externally ready at commit $DEPLOY_SOURCE_SHA\"\n                echo \"Login page responds 200 — deployment healthy\"\n                exit 0\n              fi\n              echo \"Readiness reports the new commit; /login returned HTTP ${last_login_status:-000}. Retrying.\"\n            fi\n            sleep 10\n          done\n          echo \"::error::Deployment did not become externally ready with a healthy login page within 10 minutes (last /login status: ${last_login_status:-000})\"\n          exit 1\n",".github/workflows/deploy-v1.4-dev-candidate.yml":"name: Deploy validated V1.4 candidate to DEV\n\n# This is deliberately the only feature-candidate deployment entrypoint. Pushes\n# publish candidates through uvanoo-v1.4-cloud-build.yml but never deploy them.\non:\n  workflow_dispatch:\n    inputs:\n      source_sha:\n        description: Exact, already-green V1.4 candidate commit SHA to deploy to DEV\n        required: true\n        type: string\n\n      release_evidence_sha256:\n        description: SHA256 of the approved encrypted-backup, restore and schema manifest\n        required: true\n        type: string\n\npermissions:\n  actions: read\n  contents: read\n  packages: read\n\nconcurrency:\n  # The reusable workflow owns deploy-dev so the actual rollout is serialized\n  # with main-branch deployments. This outer dispatcher must not hold that\n  # same lease while invoking it.\n  group: v1.4-dev-candidate-dispatch\n  cancel-in-progress: false\n\nenv:\n  CANDIDATE_IMAGE_NAME: ghcr.io/satho82/uvanoo-staging-private\n\njobs:\n  verify-candidate:\n    name: Verify immutable V1.4 DEV candidate\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n    outputs:\n      source_sha: ${{ steps.verify.outputs.source_sha }}\n      image_digest: ${{ steps.verify.outputs.image_digest }}\n    steps:\n      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7\n        with:\n          ref: feature/uvanoo-v1.4\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: docker/setup-buildx-action@bb05f3f5519dd87d3ba754cc423b652a5edd6d2c # v4\n      - uses: docker/login-action@af1e73f918a031802d376d3c8bbc3fe56130a9b0 # v4\n        with:\n          registry: ghcr.io\n          username: ${{ github.actor }}\n          password: ${{ github.token }}\n      - name: Verify source, authoritative validation, and published image\n        id: verify\n        env:\n          CANDIDATE_SHA: ${{ inputs.source_sha }}\n          CALLER_SHA: ${{ github.workflow_sha }}\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -euo pipefail\n          if ! [[ \"$CANDIDATE_SHA\" =~ ^[0-9a-f]{40}$ ]]; then\n            echo \"::error::source_sha must be a full lowercase commit SHA\"\n            exit 1\n          fi\n          if ! git cat-file -e \"${CANDIDATE_SHA}^{commit}\" 2>/dev/null; then\n            echo \"::error::source_sha does not identify a repository commit\"\n            exit 1\n          fi\n          if ! git merge-base --is-ancestor \"$CANDIDATE_SHA\" origin/feature/uvanoo-v1.4; then\n            echo \"::error::source_sha is not in feature/uvanoo-v1.4 history\"\n            exit 1\n          fi\n          if [ \"$CANDIDATE_SHA\" != \"$(git rev-parse origin/feature/uvanoo-v1.4)\" ] \\\n            || [ \"$CALLER_SHA\" != \"$CANDIDATE_SHA\" ]; then\n            echo '::error::Dispatch from the current feature branch and use its exact validated head; superseded candidates are forbidden'\n            exit 1\n          fi\n\n          redact_gh_stderr() {\n            sed -E \\\n              -e 's/(gh[pousr]_[[:alnum:]_]+|github_pat_[[:alnum:]_]+)/[REDACTED]/g' \\\n              -e 's/(Authorization: )[^[:space:]]+/\\1[REDACTED]/Ig' \\\n              \"$1\" | tr '\\n' ' ' | cut -c1-1000\n          }\n          api_failure() {\n            local operation=\"$1\"\n            local status=\"$2\"\n            local stderr_file=\"$3\"\n            local safe_stderr\n            safe_stderr=\"$(redact_gh_stderr \"$stderr_file\")\"\n            echo \"::error::${operation} failed (gh exit ${status}): ${safe_stderr:-no stderr captured}\" >&2\n            exit 1\n          }\n\n          # Only the exact feature branch can authorize this candidate. Check\n          # response identity too. Retries can leave more than one successful\n          # run for the same immutable SHA, so select the oldest matching run\n          # deterministically rather than treating a safe retry as ambiguity.\n          run_ids_file=\"$(mktemp)\"\n          required_jobs_file=\"$(mktemp)\"\n          gh_stderr_file=\"$(mktemp)\"\n          trap 'rm -f \"$run_ids_file\" \"$required_jobs_file\" \"$gh_stderr_file\"' EXIT\n          if gh api \\\n            \"repos/${GITHUB_REPOSITORY}/actions/workflows/uvanoo-v1.4-cloud-build.yml/runs?head_sha=${CANDIDATE_SHA}&branch=feature%2Fuvanoo-v1.4&status=completed&per_page=100\" \\\n            --jq \"if .total_count > 100 then error(\\\"Authoritative run lookup exceeds one page\\\") else\n              [.workflow_runs[] | select(.head_sha == \\\"${CANDIDATE_SHA}\\\" and\n                .head_branch == \\\"feature/uvanoo-v1.4\\\" and .status == \\\"completed\\\" and\n                .conclusion == \\\"success\\\") | .id] | sort | .[0] // empty end\" > \"$run_ids_file\" 2> \"$gh_stderr_file\"; then\n            :\n          else\n            api_failure \"authoritative-run lookup\" \"$?\" \"$gh_stderr_file\"\n          fi\n          run_id=\"$(< \"$run_ids_file\")\"\n          if ! [[ \"$run_id\" =~ ^[0-9]+$ ]]; then\n            echo \"::error::Expected a successful authoritative feature/uvanoo-v1.4 validation run for source_sha\"\n            exit 1\n          fi\n          if gh api \"repos/${GITHUB_REPOSITORY}/actions/runs/${run_id}/jobs?per_page=100\" \\\n            --jq '.jobs[] | select(.name == \"Validate frozen V1.4 source\" or .name == \"Publish immutable V1.4 DEV candidate\") | [.name, .conclusion] | @tsv' \\\n            > \"$required_jobs_file\" 2> \"$gh_stderr_file\"; then\n            :\n          else\n            api_failure \"authoritative-run jobs lookup\" \"$?\" \"$gh_stderr_file\"\n          fi\n          required_jobs=\"$(< \"$required_jobs_file\")\"\n          if [ \"$(grep -c $'^Validate frozen V1.4 source\\tsuccess$' <<< \"$required_jobs\")\" -ne 1 ] \\\n            || [ \"$(grep -c $'^Publish immutable V1.4 DEV candidate\\tsuccess$' <<< \"$required_jobs\")\" -ne 1 ]; then\n            echo \"::error::The authoritative V1.4 run did not complete both validation and candidate publication\"\n            exit 1\n          fi\n\n          image_tag=\"${CANDIDATE_IMAGE_NAME}:v1.4-dev-${CANDIDATE_SHA}\"\n          echo \"Candidate API verification passed; inspecting immutable image\"\n          # Consume all buildx output before parsing: an early pipe reader exit\n          # can make buildx exit 255 even after it prints a valid digest.\n          inspect_stderr=\"$(mktemp)\"\n          if inspect_output=\"$(docker buildx imagetools inspect \"$image_tag\" 2>\"$inspect_stderr\")\"; then\n            :\n          else\n            status=\"$?\"\n            echo \"::error::Candidate image inspection failed (exit ${status}): $(redact_gh_stderr \"$inspect_stderr\")\" >&2\n            rm -f \"$inspect_stderr\"\n            exit 1\n          fi\n          rm -f \"$inspect_stderr\"\n          digest=\"$(awk '$1 == \"Digest:\" {print $2; exit}' <<< \"$inspect_output\")\"\n          if ! [[ \"$digest\" =~ ^sha256:[0-9a-f]{64}$ ]]; then\n            echo \"::error::The published candidate tag did not resolve to an immutable sha256 digest\"\n            exit 1\n          fi\n          image=\"${CANDIDATE_IMAGE_NAME}@${digest}\"\n          docker pull \"$image\" >/dev/null\n          revision=\"$(docker image inspect \"$image\" --format '{{ index .Config.Labels \"org.opencontainers.image.revision\" }}')\"\n          version=\"$(docker image inspect \"$image\" --format '{{ index .Config.Labels \"org.opencontainers.image.version\" }}')\"\n          if [ \"$revision\" != \"$CANDIDATE_SHA\" ] \\\n            || [ \"$version\" != \"v1.4-dev-${CANDIDATE_SHA}\" ]; then\n            echo \"::error::Candidate tag, digest, and OCI source labels do not identify the requested source_sha\"\n            exit 1\n          fi\n          {\n            echo \"source_sha=$CANDIDATE_SHA\"\n            echo \"image_digest=$digest\"\n          } >> \"$GITHUB_OUTPUT\"\n          {\n            echo \"Verified DEV-only candidate source: $CANDIDATE_SHA\"\n            echo \"Verified immutable image: $image\"\n            echo \"Authoritative validation run: $run_id\"\n          } >> \"$GITHUB_STEP_SUMMARY\"\n  deploy-dev:\n    name: Deploy verified V1.4 candidate to DEV\n    needs: verify-candidate\n    permissions:\n      contents: read\n      # The reusable workflow retains its skipped main-build job, which needs\n      # package write access when called from main. GitHub validates that\n      # nested permission edge before evaluating the candidate-only job path.\n      packages: write\n    uses: ./.github/workflows/deploy-dev.yml\n    with:\n      source_sha: ${{ needs.verify-candidate.outputs.source_sha }}\n      image_digest: ${{ needs.verify-candidate.outputs.image_digest }}\n      feature_candidate_verified: true\n      release_evidence_sha256: ${{ inputs.release_evidence_sha256 }}\n    secrets: inherit\n","scripts/ci/v1.4-dev-candidate-deploy-contract.test.sh":"#!/usr/bin/env bash\n\nset -euo pipefail\n\nrepo_root=\"$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")/../..\" && pwd)\"\ncd \"$repo_root\"\n\ncandidate='.github/workflows/deploy-v1.4-dev-candidate.yml'\ncore='.github/workflows/deploy-dev.yml'\ncloud='.github/workflows/uvanoo-v1.4-cloud-build.yml'\n\nrequire() {\n  local pattern=\"$1\"\n  local file=\"$2\"\n  if ! grep -Eq -- \"$pattern\" \"$file\"; then\n    echo \"Missing required candidate-deployment contract in ${file}: ${pattern}\" >&2\n    exit 1\n  fi\n}\n\nforbid() {\n  local pattern=\"$1\"\n  local file=\"$2\"\n  if grep -Eiq -- \"$pattern\" \"$file\"; then\n    echo \"Forbidden candidate-deployment contract in ${file}: ${pattern}\" >&2\n    exit 1\n  fi\n}\n\npermission_rank() {\n  case \"$1\" in\n    none) echo 0 ;;\n    read) echo 1 ;;\n    write) echo 2 ;;\n    *)\n      echo \"Unsupported GitHub Actions permission value: $1\" >&2\n      exit 1\n      ;;\n  esac\n}\n\njob_permission() {\n  local file=\"$1\"\n  local job=\"$2\"\n  local permission=\"$3\"\n  awk -v job=\"$job\" -v permission=\"$permission\" '\n    $0 == \"  \" job \":\" { in_job = 1; next }\n    in_job && /^  [A-Za-z0-9_-]+:/ { exit }\n    in_job && /^    permissions:/ { in_permissions = 1; next }\n    in_permissions && /^    [^[:space:]]/ { exit }\n    in_permissions && $1 == permission \":\" { print $2; exit }\n  ' \"$file\"\n}\n\nassert_nested_job_permissions() {\n  local caller_permission callee_permission caller_rank callee_rank\n  for permission in contents packages; do\n    caller_permission=\"$(job_permission \"$candidate\" deploy-dev \"$permission\")\"\n    if [ -z \"$caller_permission\" ]; then\n      echo \"Missing caller permission ${permission} on candidate reusable-workflow job\" >&2\n      exit 1\n    fi\n    caller_rank=\"$(permission_rank \"$caller_permission\")\"\n    for callee_job in build deploy; do\n      callee_permission=\"$(job_permission \"$core\" \"$callee_job\" \"$permission\")\"\n      if [ -z \"$callee_permission\" ]; then\n        echo \"Missing ${permission} permission on reusable workflow job ${callee_job}\" >&2\n        exit 1\n      fi\n      callee_rank=\"$(permission_rank \"$callee_permission\")\"\n      if [ \"$callee_rank\" -gt \"$caller_rank\" ]; then\n        echo \"Reusable workflow job ${callee_job} requests ${permission}: ${callee_permission}, beyond caller cap ${caller_permission}\" >&2\n        exit 1\n      fi\n    done\n  done\n}\n\n# The feature workflow publishes images on push, but its only deployment\n# entrypoint is deliberately manual and accepts just one explicit source SHA.\nrequire '^  workflow_dispatch:$' \"$candidate\"\nforbid '^  push:' \"$candidate\"\nrequire '^      source_sha:$' \"$candidate\"\nrequire 'type: string' \"$candidate\"\nrequire '^  CANDIDATE_IMAGE_NAME: ghcr\\.io/satho82/uvanoo-staging-private$' \"$candidate\"\nforbid '^[[:space:]]*(environment|target_environment|deployment_environment):' \"$candidate\"\nforbid '^[[:space:]]*(staging|production):' \"$candidate\"\nforbid '^[[:space:]]*(target|environment):.*(staging|production)' \"$candidate\"\nrequire 'ref: feature/uvanoo-v1.4' \"$candidate\"\nrequire 'fetch-depth: 0' \"$candidate\"\nrequire '\\^\\[0-9a-f\\]\\{40\\}\\$' \"$candidate\"\nrequire 'git cat-file -e' \"$candidate\"\nrequire 'git merge-base --is-ancestor' \"$candidate\"\n\n# A green workflow conclusion alone is insufficient: both authoritative jobs\n# must have passed, and the tag must be bound to the requested source by OCI\n# labels before the digest may enter the reusable deployment workflow.\nrequire 'uvanoo-v1.4-cloud-build\\.yml/runs\\?head_sha=' \"$candidate\"\nrequire 'run_id=\"\\$\\(< \"\\$run_ids_file\"\\)\"' \"$candidate\"\nrequire '\\| sort \\| \\.\\[0\\] // empty' \"$candidate\"\nrequire 'successful authoritative feature/uvanoo-v1.4 validation run' \"$candidate\"\nrequire 'per_page=100' \"$candidate\"\nforbid 'gh api --paginate' \"$candidate\"\nrequire 'redact_gh_stderr' \"$candidate\"\nrequire 'api_failure \"authoritative-run lookup\"' \"$candidate\"\nrequire 'api_failure \"authoritative-run jobs lookup\"' \"$candidate\"\nrequire 'failed \\(gh exit \\$\\{status\\}\\)' \"$candidate\"\nrequire 'no stderr captured' \"$candidate\"\nrequire '2> \"\\$gh_stderr_file\"' \"$candidate\"\nrequire 'Validate frozen V1\\.4 source' \"$candidate\"\nrequire 'Publish immutable V1\\.4 DEV candidate' \"$candidate\"\nrequire 'v1\\.4-dev-\\$\\{CANDIDATE_SHA\\}' \"$candidate\"\nrequire 'docker buildx imagetools inspect' \"$candidate\"\nrequire '\\^sha256:\\[0-9a-f\\]\\{64\\}\\$' \"$candidate\"\nrequire 'org\\.opencontainers\\.image\\.revision' \"$candidate\"\nrequire 'org\\.opencontainers\\.image\\.version' \"$candidate\"\nrequire 'image=\"\\$\\{CANDIDATE_IMAGE_NAME\\}@\\$\\{digest\\}\"' \"$candidate\"\nforbid 'latest' \"$candidate\"\nrequire 'feature_candidate_verified: true' \"$candidate\"\nrequire 'source_sha: \\$\\{\\{ needs\\.verify-candidate\\.outputs\\.source_sha \\}\\}' \"$candidate\"\nrequire 'image_digest: \\$\\{\\{ needs\\.verify-candidate\\.outputs\\.image_digest \\}\\}' \"$candidate\"\n\n# Parse the workflow graph so a missing job output, an accidental caller guard,\n# or a concurrency self-deadlock cannot silently omit the reusable deployment.\nruby <<'RUBY'\nrequire 'yaml'\n\ncandidate = YAML.safe_load(File.read('.github/workflows/deploy-v1.4-dev-candidate.yml'), aliases: true)\ncore = YAML.safe_load(File.read('.github/workflows/deploy-dev.yml'), aliases: true)\nverify = candidate.dig('jobs', 'verify-candidate')\ndeploy = candidate.dig('jobs', 'deploy-dev')\n\nunless verify.dig('outputs', 'source_sha')&.include?('steps.verify.outputs.source_sha') &&\n       verify.dig('outputs', 'image_digest')&.include?('steps.verify.outputs.image_digest')\n  abort 'Verifier must declare the source_sha and image_digest job outputs consumed downstream'\nend\nabort 'Candidate reusable deployment must need verify-candidate' unless deploy['needs'] == 'verify-candidate'\nabort 'Candidate reusable deployment must not use a caller-level guard that can suppress a verified deploy' if deploy.key?('if')\nunless deploy.dig('with', 'source_sha') == '${{ needs.verify-candidate.outputs.source_sha }}' &&\n       deploy.dig('with', 'image_digest') == '${{ needs.verify-candidate.outputs.image_digest }}' &&\n       deploy.dig('with', 'feature_candidate_verified') == true\n  abort 'Candidate reusable deployment must pass only the declared verified outputs and verification flag'\nend\nabort 'Candidate dispatcher must not hold the reusable deployment concurrency group' if candidate.dig('concurrency', 'group') == core.dig('concurrency', 'group')\nabort 'Reusable deployment workflow must retain the canonical deploy-dev concurrency group' unless core.dig('concurrency', 'group') == 'deploy-dev'\ncore_deploy = core.dig('jobs', 'deploy')\nrequire 'tmpdir'\nrequire 'fileutils'\nrequire 'open3'\nunless core_deploy.dig('env', 'DEPLOY_GOVERNANCE_SHA') == '${{ github.workflow_sha }}'\n  abort 'Deployment governance must be pinned to the caller workflow commit'\nend\ncheckouts = core_deploy['steps'].select { |step| step['uses'].to_s.start_with?('actions/checkout@') }\nunless checkouts.any? { |step| step.dig('with', 'ref') == '${{ env.DEPLOY_SOURCE_SHA }}' && !step.dig('with', 'path') } &&\n       checkouts.any? { |step| step.dig('with', 'ref') == '${{ env.DEPLOY_GOVERNANCE_SHA }}' && step.dig('with', 'path') == '.deployment-governance' }\n  abort 'Frozen application and governance must use distinct pinned checkouts'\nend\nunless candidate.dig('jobs', 'deploy-dev', 'uses') == './.github/workflows/deploy-dev.yml' &&\n       YAML.safe_load(File.read('.github/workflows/ci.yml'), aliases: true)['jobs'].values.any? { |job| job['uses'] == './.github/workflows/deploy-dev.yml' }\n  abort 'Both callers must use the same-commit relative reusable workflow'\nend\ngovern