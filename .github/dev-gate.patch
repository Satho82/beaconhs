o::EPIPE\n        exit 255\n      end\n    when 'pull'\n      File.write(ENV.fetch('PULL_MARKER'), ARGV.fetch(1))\n      exit 1 if ENV['CASE'] == 'pull-failure'\n      # Docker rejects content that does not match the requested digest.\n      if ARGV.fetch(1) != \"#{ENV.fetch('CANDIDATE_IMAGE_NAME')}@#{ENV.fetch('DIGEST')}\"\n        warn 'content digest does not match requested digest'\n        exit 1\n      end\n    when 'image'\n      if ARGV.last.include?('image.revision')\n        puts ENV['CASE'] == 'wrong-revision' ? 'wrong' : ENV.fetch('CANDIDATE_SHA')\n      else\n        puts ENV['CASE'] == 'wrong-version' ? 'wrong' : \"v1.4-dev-#{ENV.fetch('CANDIDATE_SHA')}\"\n      end\n    else\n      abort 'Unexpected docker command'\n    end\n  RUBY_FIXTURE\n  FileUtils.chmod(0755, %w[git gh docker].map { |name| \"#{dir}/#{name}\" })\n  sha = 'a' * 40\n  digest = \"sha256:#{'b' * 64}\"\n  env = {\n    'PATH' => \"#{dir}:#{ENV['PATH']}\", 'CANDIDATE_SHA' => sha, 'CALLER_SHA' => sha,\n    'CANDIDATE_IMAGE_NAME' => 'ghcr.io/example/candidate', 'DIGEST' => digest,\n    'GITHUB_REPOSITORY' => 'example/repo', 'GITHUB_OUTPUT' => \"#{dir}/outputs\",\n    'GITHUB_STEP_SUMMARY' => \"#{dir}/summary\", 'PULL_MARKER' => \"#{dir}/pull\"\n  }\n  _, _, broken = Open3.capture3(env, 'bash', '-c',\n    %q{set -euo pipefail; digest=\"$(docker buildx imagetools inspect fixture | awk '$1 == \"Digest:\" {print $2; exit}')\"})\n  abort 'Regression fixture must reproduce original exit 255' unless broken.exitstatus == 255\n  %w[success feature-plus-visual ambiguous-feature failed-feature incomplete-feature sha-mismatch\n    visual-only truncated-runs digest-mismatch inspect-failure invalid-digest pull-failure wrong-revision wrong-version old-caller].each do |scenario|\n    FileUtils.rm_f([env['GITHUB_OUTPUT'], env['PULL_MARKER']])\n    overrides = { 'CASE' => scenario }\n    overrides['CALLER_SHA'] = 'c' * 40 if scenario == 'old-caller'\n    stdout, stderr, status = Open3.capture3(env.merge(overrides), 'bash', '-c', verify.fetch('run'))\n    outputs = File.exist?(env['GITHUB_OUTPUT']) ? File.read(env['GITHUB_OUTPUT']) : ''\n    if %w[success feature-plus-visual ambiguous-feature].include?(scenario)\n      abort \"Verifier rejected valid authoritative run in #{scenario}: #{stdout}#{stderr}\" unless status.success? &&\n        outputs == \"source_sha=#{sha}\\nimage_digest=#{digest}\\n\" &&\n        File.read(env['PULL_MARKER']) == \"ghcr.io/example/candidate@#{digest}\"\n    else\n      abort \"Verifier accepted #{scenario}\" if status.success? || !outputs.empty?\n      if %w[ambiguous-feature failed-feature incomplete-feature sha-mismatch visual-only truncated-runs inspect-failure invalid-digest old-caller].include?(scenario)\n        abort \"Verifier pulled image after #{scenario}\" if File.exist?(env['PULL_MARKER'])\n      end\n      if scenario == 'inspect-failure'\n        abort 'Inspection error must preserve exit context and redact credentials' unless\n          (stdout + stderr).include?('exit 255') && !(stdout + stderr).include?('ghp_fixtureSecret123')\n      end\n    end\n    puts \"PASS candidate verifier #{scenario}\"\n  end\nend\n# Execute the actual migration shell with a failing zero-writer guard. The\n# mocked docker marker must remain absent: no database operation is allowed.\nDir.mktmpdir('dev-fence-contract-') do |dir|\n  File.write(\"#{dir}/node\", \"#!/bin/sh\\nexit 1\\n\")\n  File.write(\"#{dir}/docker\", \"#!/bin/sh\\ntouch \\\"$DOCKER_MARKER\\\"\\n\")\n  FileUtils.chmod(0755, [\"#{dir}/node\", \"#{dir}/docker\"])\n  _, _, status = Open3.capture3({ 'PATH' => \"#{dir}:#{ENV['PATH']}\", 'FEATURE_CANDIDATE_VERIFIED' => 'true',\n    'DOCKER_MARKER' => \"#{dir}/docker-ran\" }, 'bash', '-c', migration['run'])\n  abort 'Migration ran after zero-writer guard failure' if status.success? || File.exist?(\"#{dir}/docker-ran\")\nend\nRUBY\n\necho 'PASS V1.4 candidate deployment is manual, DEV-only, digest-bound and writer-fenced'\n","packages/db/src/dev-migration-gate.test.ts":"import { describe, expect, it } from 'vitest'\nimport { readFileSync, cpSync, mkdtempSync, writeFileSync, rmSync } from 'node:fs'\nimport { tmpdir } from 'node:os'\nimport { resolve } from 'node:path'\nimport { fileURLToPath } from 'node:url'\nimport {\n  strictPrefix, sourceMigrations, validateEvidence, digest, ledgerFingerprint,\n  devMigrationFolder, type ReleaseEvidence, type LedgerRow,\n} from './dev-migration-gate'\n\nconst files = sourceMigrations(devMigrationFolder)\nconst rows: LedgerRow[] = files.map((f, i) => ({ id: i + 1, hash: f.hash, created_at: String(f.createdAt) }))\nconst now = Date.parse('2026-10-12T21:00:00Z')\nconst identity = { sourceSha: 'a'.repeat(40), sourceTree: 'b'.repeat(40), imageDigest: 'sha256:' + 'c'.repeat(64) }\nfunction evidence(): ReleaseEvidence {\n  const hash = digest('fixture')\n  return {\n    version: 1, ...identity, database: 'beaconhs', databaseOid: 123, postgresVersion: '160015',\n    migrations: files, schemas: { [files.length]: hash },\n    backup: {\n      file: 'backup.dump.age', sha256: hash, createdAt: '2026-10-12T20:50:00Z',\n      restoredAt: '2026-10-12T20:55:00Z',\n      restoreRun: 'https://github.com/Satho82/beaconhs/actions/runs/123',\n      ledgerHash: hash, dataHash: hash, schemaHash: hash,\n      restoredLedgerHash: hash, restoredDataHash: hash, restoredSchemaHash: hash,\n      rollbackImageDigest: identity.imageDigest,\n    },\n  }\n}\ndescribe('strict DEV release migration gate', () => {\n  it.each(['sql', 'journal-order', 'timestamp', 'unregistered'])('rejects altered source %s', (kind) => {\n    const folder = mkdtempSync(resolve(tmpdir(), 'dev-gate-source-'))\n    try {\n      cpSync(devMigrationFolder, folder, { recursive: true })\n      if (kind === 'sql') writeFileSync(resolve(folder, files[0]!.tag + '.sql'), '-- changed')\n      if (kind === 'unregistered') writeFileSync(resolve(folder, '9999_unregistered.sql'), 'SELECT 1;')\n      const path = resolve(folder, 'meta/_journal.json')\n      const journal = JSON.parse(readFileSync(path, 'utf8'))\n      if (kind === 'journal-order') journal.entries[0].idx = 9\n      if (kind === 'timestamp') journal.entries[0].when += 1\n      writeFileSync(path, JSON.stringify(journal))\n      expect(() => sourceMigrations(folder)).toThrow()\n    } finally { rmSync(folder, { recursive: true, force: true }) }\n  })\n  it('accepts an exact historical prefix and the complete source', () => {\n    expect(strictPrefix(files, rows.slice(0, 58))).toBe(58)\n    expect(strictPrefix(files, rows)).toBe(files.length)\n  })\n  it.each(['empty', 'gap', 'duplicate', 'hash', 'timestamp', 'order', 'ahead'])('rejects %s history', (kind) => {\n    const bad = structuredClone(rows)\n    if (kind === 'empty') bad.length = 0\n    if (kind === 'gap') bad.splice(10, 1)\n    if (kind === 'duplicate') bad[10] = { ...bad[9]! }\n    if (kind === 'hash') bad[10]!.hash = '0'.repeat(64)\n    if (kind === 'timestamp') bad[10]!.created_at = 1\n    if (kind === 'order') [bad[9], bad[10]] = [bad[10]!, bad[9]!]\n    if (kind === 'ahead') bad.push({ id: 999, hash: '0'.repeat(64), created_at: 9999999999999 })\n    expect(() => strictPrefix(files, bad)).toThrow()\n  })\n  it('accepts only evidence bound to the exact release', () => {\n    expect(() => validateEvidence(evidence(), files, identity, now)).not.toThrow()\n    for (const key of ['sourceSha', 'sourceTree', 'imageDigest'] as const) {\n      const bad = evidence()\n      bad[key] = 'wrong'\n      expect(() => validateEvidence(bad, files, identity, now)).toThrow()\n    }\n    const bad = evidence()\n    bad.migrations = files.slice(1)\n    expect(() => validateEvidence(bad, files, identity, now)).toThrow()\n  })\n  it.each(['stale', 'future', 'restore', 'checksum', 'path', 'rollback', 'schema'])('rejects %s recovery evidence', (kind) => {\n    const bad = evidence()\n    if (kind === 'stale') bad.backup.createdAt = '2026-10-11T20:50:00Z'\n    if (kind === 'future') bad.backup.restoredAt = '2026-10-13T20:50:00Z'\n    if (kind === 'restore') bad.backup.restoredDataHash = '0'.repeat(64)\n    if (kind === 'checksum') bad.backup.sha256 = ''\n    if (kind === 'path') bad.backup.file = '../backup.dump.age'\n    if (kind === 'rollback') bad.backup.rollbackImageDigest = 'latest'\n    if (kind === 'schema') bad.schemas = {}\n    expect(() => validateEvidence(bad, files, identity, now)).toThrow()\n  })\n  it('ledger identity cannot hide order changes', () => {\n    expect(ledgerFingerprint(rows)).not.toBe(ledgerFingerprint([...rows].reverse()))\n  })\n  it('requires reviewed evidence and only replaces the DEV execution route', () => {\n    const workflow = readFileSync(fileURLToPath(new URL('../../../.github/workflows/deploy-dev.yml', import.meta.url)), 'utf8')\n    expect(workflow).not.toContain('clean155')\n    expect(workflow).not.toContain('src/verify-prepared-risk.ts')\n    expect(workflow).toContain('migration_entrypoint=src/migrate.ts')\n    expect(workflow).toContain('migration_entrypoint=src/migrate-dev.ts')\n    expect(workflow).toContain('/release-evidence:ro')\n    expect(workflow).toContain('inputs.release_evidence_sha256')\n    expect(workflow.indexOf('- name: Validate DEV release evidence input')).toBeLessThan(workflow.indexOf('- name: Run database migrations'))\n  })\n  it('keeps the DEV preflight under the canonical lock and before privilege writes', () => {\n    const code = readFileSync(fileURLToPath(new URL('./migrate.ts', import.meta.url)), 'utf8')\n    expect(code.indexOf('if (devGate) await devGate.before')).toBeGreaterThan(code.indexOf('lockAcquired = true'))\n    expect(code.indexOf('if (devGate) await devGate.before')).toBeLessThan(code.indexOf('await prepareMigrationPrivileges'))\n    expect(code.indexOf('if (devGate) await devGate.after')).toBeLessThan(code.indexOf('if (lockAcquired)'))\n  })\n})\n","packages/db/src/dev-migration-gate.integration.ts":"/** Disposable cloud-only regression. No infrastructure or persistent target access. */\nimport assert from 'node:assert/strict'\nimport { execFileSync } from 'node:child_process'\nimport { cpSync, mkdtempSync, readFileSync, rmSync, symlinkSync, writeFileSync } from 'node:fs'\nimport { tmpdir } from 'node:os'\nimport { resolve } from 'node:path'\nimport { fileURLToPath } from 'node:url'\nimport postgres from 'postgres'\nimport { pinnedMigrationDatabase } from './migration-connection'\nimport { executePendingMigrations, loadMigrationBodies } from './migration-execution'\nimport {\n  sourceMigrations, strictPrefix, schemaFingerprint, readLedger, ledgerFingerprint,\n  verifyState, dataFingerprint, type Query, type ReleaseEvidence,\n} from './dev-migration-gate'\n\nif (process.env.CI !== 'true' || process.env.DEV_GATE_DISPOSABLE !== 'true')\n  throw new Error('Explicit disposable CI context required')\nconst root = fileURLToPath(new URL('..', import.meta.url))\nconst repo = resolve(root, '../..')\nconst source = '937242e7e35806acab48c28c4163719b00c0f16d'\nconst work = mkdtempSync(resolve(tmpdir(), 'uvanoo-dev-gate-'))\nconst admin = postgres('postgresql://postgres:postgres@127.0.0.1:5432/postgres', { max: 1, onnotice: () => undefined })\nconst databases: string[] = []\nconst queryFor = (client: ReturnType<typeof postgres>): Query => async (s) => Array.from(await client.unsafe(s)) as Record<string, unknown>[]\nconst q = (name: string) => '\"' + name.replaceAll('\"', '\"\"') + '\"'\ntry {\n  cpSync(resolve(root, 'src'), resolve(work, 'src'), { recursive: true })\n  cpSync(resolve(root, 'drizzle'), resolve(work, 'drizzle'), { recursive: true })\n  symlinkSync(resolve(root, 'node_modules'), resolve(work, 'node_modules'), 'dir')\n  writeFileSync(resolve(work, 'package.json'), '{\"type\":\"module\"}')\n  for (const file of ['0062_approvals_batch01.sql', '0063_approvals_production.sql', 'meta/_journal.json']) {\n    writeFileSync(resolve(work, 'drizzle', file), execFileSync('git', ['show', source + ':packages/db/drizzle/' + file], { cwd: repo }))\n  }\n  const folder = resolve(work, 'drizzle')\n  const fullJournal = readFileSync(resolve(folder, 'meta/_journal.json'), 'utf8')\n  const all = sourceMigrations(folder)\n  assert.equal(all.length, 63)\n  for (const prefix of [58, 61, 62, 63]) {\n    const name = 'dev_gate_fixture_' + prefix\n    databases.push(name)\n    await admin.unsafe('CREATE DATABASE ' + q(name) + ' OWNER beaconhs_owner')\n    const setup = postgres('postgresql://postgres:postgres@127.0.0.1:5432/' + name, { max: 1, onnotice: () => undefined })\n    await setup.unsafe('ALTER SCHEMA public OWNER TO beaconhs_owner; REVOKE ALL ON SCHEMA public FROM PUBLIC')\n    await setup.end()\n    const url = (role: string) => 'postgresql://' + role + ':' + role + '@127.0.0.1:5432/' + name\n    const env = { ...process.env, FEATURE_CANDIDATE_VERIFIED: 'false', MIGRATION_DATABASE_URL: url('beaconhs_migrator'), DATABASE_URL: url('beaconhs_app'), SUPERADMIN_DATABASE_URL: url('beaconhs_super') }\n    const journal = JSON.parse(fullJournal)\n    journal.entries = journal.entries.slice(0, prefix)\n    writeFileSync(resolve(folder, 'meta/_journal.json'), JSON.stringify(journal))\n    execFileSync(process.execPath, ['--import', 'tsx', resolve(work, 'src/migrate.ts')], { cwd: root, env, stdio: 'pipe' })\n    writeFileSync(resolve(folder, 'meta/_journal.json'), fullJournal)\n    const client = postgres(url('beaconhs_migrator'), { max: 1, onnotice: () => undefined })\n    const reserved = await client.reserve()\n    const db = pinnedMigrationDatabase(reserved)\n    const query: Query = async (s) => Array.from(await reserved.unsafe(s)) as Record<string, unknown>[]\n    await reserved.unsafe('SET ROLE beaconhs_owner')\n    const rows = await readLedger(query)\n    assert.equal(strictPrefix(all, rows), prefix)\n    const before = await schemaFingerprint(query)\n    const [id] = await query(\"SELECT current_database() name,(SELECT oid::integer FROM pg_database WHERE datname=current_database()) oid,current_setting('server_version_num') version\")\n    const evidence = { database: name, databaseOid: id!.oid, postgresVersion: id!.version, schemas: { [prefix]: before }, backup: { ledgerHash: ledgerFingerprint(rows), schemaHash: before } } as ReleaseEvidence\n    await verifyState(query, evidence, all, false)\n    await reserved.unsafe('CREATE TABLE public.unrecorded_drift(id integer)')\n    await assert.rejects(() => verifyState(query, evidence, all, false), /drift/)\n    await reserved.unsafe('DROP TABLE public.unrecorded_drift')\n    await reserved.unsafe('GRANT DELETE ON risk_assessments TO PUBLIC')\n    await assert.rejects(() => verifyState(query, evidence, all, false), /drift/)\n    await reserved.unsafe('REVOKE DELETE ON risk_assessments FROM PUBLIC')\n    await verifyState(query, evidence, all, false)\n    await admin.unsafe('GRANT beaconhs_owner TO beaconhs_backup')\n    try { await assert.rejects(() => verifyState(query, evidence, all, false), /drift/) }\n    finally { await admin.unsafe('REVOKE beaconhs_owner FROM beaconhs_backup') }\n    if (prefix >= 61) {\n      await reserved.unsafe('ALTER TABLE risk_assessment_versions DISABLE TRIGGER risk_assessment_versions_immutable_row')\n      await assert.rejects(() => verifyState(query, evidence, all, false), /drift/)\n      await reserved.unsafe('ALTER TABLE risk_assessment_versions ENABLE TRIGGER risk_assessment_versions_immutable_row')\n    }\n    await reserved.unsafe(\"SELECT pg_advisory_lock(hashtext('beaconhs:schema-migration'))\")\n    const pending = await executePendingMigrations(db, loadMigrationBodies(folder, all))\n    assert.equal(pending.length, 63 - prefix)\n    await reserved.unsafe(\"SELECT pg_advisory_unlock(hashtext('beaconhs:schema-migration'))\")\n    reserved.release()\n    await client.end()\n    // Run the complete convergence path; target security must survive it.\n    execFileSync(process.execPath, ['--import', 'tsx', resolve(work, 'src/migrate.ts')], { cwd: root, env, stdio: 'pipe' })\n    const verify = postgres(url('beaconhs_migrator'), { max: 1, onnotice: () => undefined })\n    await verify.unsafe('SET ROLE beaconhs_owner')\n    const verifyQuery = queryFor(verify)\n    const finalRows = await readLedger(verifyQuery)\n    assert.equal(strictPrefix(all, finalRows), 63)\n    evidence.schemas['63'] = await schemaFingerprint(verifyQuery)\n    await verifyState(verifyQuery, evidence, all, true)\n    const [security] = await verify.unsafe(\"SELECT NOT has_table_privilege('beaconhs_app','risk_assessment_versions','UPDATE,DELETE,TRUNCATE') risk, NOT has_table_privilege('beaconhs_app','approval_requests','UPDATE') approval, has_column_privilege('beaconhs_app','approval_requests','status','UPDATE') status, NOT has_column_privilege('beaconhs_app','approval_requests','requester_id','UPDATE') requester, has_table_privilege('beaconhs_backup','approval_activity','SELECT') backup, NOT has_table_privilege('beaconhs_backup','approval_activity','INSERT,UPDATE,DELETE,TRUNCATE') backup_readonly\")\n    assert.ok(security && Object.values(security).every((v) => v === true))\n    await verify.end()\n    const backup = postgres(url('beaconhs_backup'), { max: 1, onnotice: () => undefined })\n    const firstData = await dataFingerprint(queryFor(backup))\n    assert.equal(firstData, await dataFingerprint(queryFor(backup)))\n    await backup.end()\n    console.log('PASS canonical ' + prefix + ' -> 63, exact ledger, schema/ACL drift rejection and Risk/Approvals/backup protections')\n  }\n} finally {\n  for (const name of databases) await admin.unsafe('DROP DATABASE IF EXISTS ' + q(name) + ' WITH (FORCE)')\n  await admin.end()\n  rmSync(work, { recursive: true, force: true })\n}\n","docs/DEV-MIGRATION-GATE.md":"# DEV release migration gate\n\nThis gate applies only to the verified V1.4 DEV candidate path. Ordinary main,\nstaging and production execution is unchanged. No SQL migration is rewritten.\nThe historical clean-database verifier remains historical evidence and is no\nlonger the DEV deployment entrypoint.\n\n## Release contract\n\nDispatch requires an owner-approved SHA-256 of manifest.json. Store the manifest\nand its encrypted backup together under\n/opt/uvanoo-dev/release-evidence/EXACT_SOURCE_SHA/. The deployment mounts that\ndirectory read-only. Neither a boolean \"backup done\" nor a mutable image tag is\naccepted. The digest is an authorization input, not generated from the live\ndatabase by the deployment. Review the restore-run evidence before approving it.\n\nThe ReleaseEvidence type in packages/db/src/dev-migration-gate.ts is the exact\nmanifest schema. It binds the source commit/tree, image digest, ordered migration\nSHA-256 identities, database name/OID/version, independently rehearsed schema\nfingerprints for supported starting prefixes and the complete target, encrypted\nbackup checksum, restored ledger/data/schema fingerprints, restore Actions URL,\nand an immutable rollback image. Backup and restore evidence expires after one\nhour. Unknown fields do not grant additional permissions.\n\nCreate the reference schema fingerprints by replaying the exact source on a\ndisposable PostgreSQL cluster with the canonical roles and full convergence\nphases. Never derive an approved reference by accepting the live catalogue as\ncorrect. Explicitly reconcile legitimate environment-specific role/ACL differences\nbefore approval. Restore verification must compare the backup's ledger, catalogue,\nand data with the source snapshot, including ownership/grants reapplied from the\nreviewed security contract: repository logical dumps intentionally omit ACLs.\n\nDEV_BACKUP_DATABASE_URL must connect to the same database/server as the migrator,\nusing beaconhs_backup. The backup role has cross-tenant SELECT, default read-only,\nno ownership or DML. Credentials remain repository/environment secrets.\n\n## Execution ordering\n\nThe existing control-plane writer fence covers web, worker and scheduler.\nBefore releasing the fence, the canonical runner must pass:\n\n1. Exact checked-out source, immutable history, journal and approved evidence.\n2. Encrypted-backup checksum.\n3. Existing role checks and the canonical session migration lock.\n4. Strict ordered ledger prefix, database identity and schema/security fingerprint.\n5. Backup-role data fingerprint matching the verified restore evidence.\n6. Atomic per-migration SQL and ledger commits, with no legacy hash exception.\n7. Existing RLS, grants, template, RBAC, reporting and statistics convergence.\n8. Exact complete target ledger and approved final schema/security fingerprint.\n\nThe complete runner includes data and RBAC convergence; it is never a read-only\ncheck, including when no DDL is pending. Review these effects as part of release\nacceptance. Deployment alone cannot certify that a rollback image is compatible;\nthe recovery plan must identify either a compatible image or a verified database\nrestore into a separate recovery database. Never delete migration ledger rows.\n\nFixed demo row counts are not compatibility checks. The gate hashes actual\nbackup-covered data without publishing it. Data changed after backup is rejected.\nNo automatic retry, ledger repair, schema adoption or down migration is performed.\nAfter failure, writers stay fenced until an explicit recovery review.\n\n## Integration and recovery prerequisites\n\nThis isolated correction branch retains the governed 61-file SQL baseline.\nDisposable tests import canonical 0062/0063 from immutable recovered source\n937242e7e35806acab48c28c4163719b00c0f16d. Their Git blob identities are locked\nalongside all original migrations. A later combined candidate must retain those\nbytes and pass the complete release gates. Future migrations require a new\napproved manifest and rehearsal; a numerical migration count is not authorization.\n\nThe intended persistent DEV endpoints are uvanoo-dev-postgres/beaconhs and\nuvanoo-dev-redis. Do not switch secrets or networks until the actual database,\nsurviving clean-database volumes, tenant-data differences, Redis queues and all\nroles have been inspected. This code does not perform those operations.\n\nA missing reference fingerprint, backup, restored evidence, role, schema object,\nhistorical identity or release binding blocks deployment. No live compatibility\nor deployment readiness is implied by disposable CI success.\n","knip.ts":"import type { KnipConfig } from 'knip'\n\nconst config: KnipConfig = {\n  $schema: 'https://unpkg.com/knip@5/schema.json',\n  workspaces: {\n    '.': {\n      entry: [\n        'deploy/collabora-branding.js',\n        'scripts/check-sanitizer-boundary.mjs',\n        // Executed by the shell deployment-contract suite in both CI lanes.\n        'scripts/cluster/dev-writer-fence.test.mjs',\n        'scripts/cluster/dev-readiness.test.mjs',\n      ],\n      // The sanitizer audit resolves these through apps/web's createRequire.\n      ignoreDependencies: ['next', 'jsdom'],\n    },\n    'apps/web': {\n      // Next externalizes the shared sanitizer through this runtime dependency.\n      ignoreDependencies: ['isomorphic-dompurify'],\n      entry: [\n        'public/sw.js',\n        'src/**/*.test.{ts,tsx}',\n        'scripts/**/*.test.ts',\n        'scripts/i18n-runtime-audit.ts',\n        'scripts/backfill-credential-outputs.ts',\n        'scripts/cleanup-rassaun-credential-designs.ts',\n        'scripts/backfill-private-attachment-urls.ts',\n        'scripts/backfill-signatures-to-storage.ts',\n        'scripts/backfill-tenant-storage-keys.ts',\n        'scripts/generate-brand-icons.mjs',\n        'scripts/materialize-compliance.ts',\n        'scripts/dev-first-identity.ts',\n        'scripts/dev-minimal-tenant.ts',\n        'scripts/normalize-ppe-inspection-notes.ts',\n        'scripts/restore-equipment-preuse-links.ts',\n        'scripts/restore-ppe-custody-from-legacy.ts',\n        'scripts/restore-ppe-serial-numbers.ts',\n      ],\n    },\n    'apps/worker': {\n      entry: ['src/health.ts', 'src/storage-init.ts'],\n      // Bundled @beaconhs/forms-pdf keeps `qrcode` external; the worker image\n      // must still resolve it at runtime.\n      ignoreDependencies: ['qrcode'],\n    },\n    'packages/auth': {\n      // CLI entrypoints launched through the db package's existing tsx runtime.\n      entry: ['src/create-cycas-demo-credentials.ts', 'src/cycas-board.integration.ts'],\n    },\n    'packages/db': {\n      entry: ['src/scripts/reseed-lift-plan.ts', 'src/forward-migration-cli.ts', 'src/migrate-dev.ts', 'src/dev-migration-gate.integration.ts'],\n    },\n    'packages/sync': {\n      ignoreDependencies: ['mssql'],\n    },\n  },\n}\n\nexport default config\n"}