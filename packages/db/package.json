{
  "name": "@beaconhs/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./risk-matrix": "./src/risk-matrix.ts",
    "./risk-library": "./src/risk-library.ts",
    "./rls": "./src/rls.ts",
    "./canonical-templates": "./src/canonical-templates.ts",
    "./seed/lift-plan-template": "./src/seed/lift-plan-template.ts",
    "./seed/pdf-templates": "./src/seed/pdf-templates.ts",
    "./seed/report-definitions": "./src/seed/report-definitions.ts",
    "./cycas-demo-seed-plan": "./src/cycas-demo-seed-plan.ts",
    "./cycas-demo-seed-runner": "./src/cycas-demo-seed-runner.ts",
    "./cycas-demo-seed-rows": "./src/cycas-demo-seed-rows.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "push": "drizzle-kit push",
    "push:ci": "drizzle-kit push --force",
    "studio": "drizzle-kit studio",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "seed:demo-hotel": "tsx src/seed-demo-hotel.ts",
    "test": "vitest run",
    "test:action-property-sql": "tsx src/action-property-test-sql.ts",
    "test:people-provenance": "tsx src/people-provenance.integration.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "seed:cycas-demo": "tsx src/seed-cycas-demo.ts"
  },
  "dependencies": {
    "@braedonsaunders/appkit-reports": "^1.1.0",
    "@beaconhs/forms-core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
